@page "/Login"
@model MuhasebeTakip2.App.Pages.LoginModel
@{
    ViewData["Title"] = "Giriş";
}

<div style="
    position:fixed;
    inset:0;
    width:100vw;
    height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(to bottom, #ffffff 0%, #eef2ff 55%, #c7d2fe 100%);
    padding:30px;
    overflow:auto;
    z-index:9999;
">

    <div style="
        width:430px;
        max-width:100%;
        background:rgba(255,255,255,0.97);
        border-radius:20px;
        padding:34px;
        box-shadow:0 18px 40px rgba(15,23,42,0.12);
        border:1px solid #dbe4ee;
    ">

        <div style="text-align:center; margin-bottom:26px;">
           <div style="font-size:28px; font-weight:800;">
            Firmova ERP
        </div>

            <div style="margin-top:10px; font-size:14px; color:#64748b;">
                Lütfen kullanıcı bilgileriniz ile giriş yapın
            </div>
        </div>

        @if (TempData["Mesaj"] != null)
        {
            <div style="color:#166534; border:1px solid #bbf7d0; background:#f0fdf4; padding:10px 12px; border-radius:10px; margin-bottom:16px;">
                @TempData["Mesaj"]
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Hata))
        {
            <div style="color:#b42318; border:1px solid #fecaca; background:#fef2f2; padding:10px 12px; border-radius:10px; margin-bottom:16px;">
                @Model.Hata
            </div>
        }

        <form method="post">
            <div style="margin-bottom:16px;">
            <label style="display:block; font-weight:700; margin-bottom:6px; color:#475569;">Kullanıcı Adı veya Mail</label>                <input asp-for="KullaniciAdi" style="width:100%; padding:12px; border:1px solid #cbd5e1; border-radius:12px;" />
            </div>

            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:700; margin-bottom:6px; color:#475569;">Şifre</label>

                <div style="display:flex; gap:8px;">
                    <input asp-for="Sifre" id="sifreInput" type="password" style="flex:1; padding:12px; border:1px solid #cbd5e1; border-radius:12px;" />

                    <button type="button" onclick="sifreGosterGizle(event)" style="padding:12px 14px; border:1px solid #cbd5e1; border-radius:12px; background:#eef2ff; color:#312e81; font-weight:700;">
                        Göster
                    </button>
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:10px;">
                <button type="submit" style="flex:1; padding:13px; border:none; border-radius:14px; background:#6366f1; color:white; font-size:16px; font-weight:800;">
                    Giriş Yap
                </button>

                <a href="/Register" style="flex:1; display:flex; align-items:center; justify-content:center; padding:13px; border-radius:14px; background:#312e81; color:white; font-size:16px; font-weight:800; text-decoration:none;">
                    Kayıt Ol
                </a>
            </div>

            <div style="margin-top:18px; text-align:center;">
    <a href="/SifremiUnuttum"
       style="
            display:inline-block;
            padding:10px 14px;
            color:#312e81;
            background:#eef2ff;
            border:1px solid #c7d2fe;
            border-radius:12px;
            font-size:14px;
            font-weight:800;
            text-decoration:none;">
        Şifremi Unuttum
    </a>
</div>
        </form>
    </div>
</div>

<script>
    function sifreGosterGizle(e) {
        var input = document.getElementById("sifreInput");
        var button = e.target;

        if (input.type === "password") {
            input.type = "text";
            button.innerText = "Gizle";
        } else {
            input.type = "password";
            button.innerText = "Göster";
        }
    }
</script>