@page
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.Odemeler.EkleModel
@{
    ViewData["Title"] = "Yeni Ödeme";
}

@functions {
    private static string OdemeTuruMetni(OdemeTuru tur) => tur switch
    {
        OdemeTuru.Kredi => "Kredi",
        OdemeTuru.KrediKarti => "Kredi Kartı",
        OdemeTuru.Kira => "Kira",
        OdemeTuru.Vergi => "Vergi",
        OdemeTuru.Fatura => "Fatura",
        OdemeTuru.Personel => "Personel",
        OdemeTuru.Abonelik => "Abonelik",
        _ => "Diğer"
    };
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Ödeme Planı</span>
            <h1>Yeni Ödeme</h1>
            <p>Tekrarlayan ödeme veya taksit planı oluşturun.</p>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-outline-dark" href="/Odemeler">Geri Dön</a>
        </div>
    </section>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="app-form-panel">
        <form method="post" class="app-form-grid">
            <div class="form-field form-field-wide"><label asp-for="Form.OdemeAdi">Ödeme Adı</label><input asp-for="Form.OdemeAdi" /></div>
            <div class="form-field">
                <label asp-for="Form.OdemeTuru">Ödeme Türü</label>
                <select asp-for="Form.OdemeTuru">
                    @foreach (var tur in Enum.GetValues<OdemeTuru>())
                    {
                        <option value="@tur">@OdemeTuruMetni(tur)</option>
                    }
                </select>
            </div>
            <div class="form-field"><label asp-for="Form.AylikOdemeTutari">Aylık Ödeme Tutarı</label><input asp-for="Form.AylikOdemeTutari" type="number" step="0.01" min="0" /></div>
            <div class="form-field"><label asp-for="Form.ToplamTaksitSayisi">Toplam Taksit Sayısı</label><input asp-for="Form.ToplamTaksitSayisi" type="number" min="1" /></div>
            <div class="form-field"><label asp-for="Form.KalanTaksitSayisi">Kalan Taksit Sayısı</label><input asp-for="Form.KalanTaksitSayisi" type="number" min="0" placeholder="Boşsa toplam taksit" /></div>
            <div class="form-field"><label asp-for="Form.IlkOdemeTarihi">İlk Ödeme Tarihi</label><input asp-for="Form.IlkOdemeTarihi" type="date" /></div>
            <div class="form-field"><label asp-for="Form.BildirimGunu">Bildirim Kaç Gün Önce Gönderilsin</label><input asp-for="Form.BildirimGunu" type="number" min="0" /></div>
            <div class="form-field form-field-wide"><label asp-for="Form.Aciklama">Açıklama</label><input asp-for="Form.Aciklama" /></div>
            <div class="form-field"><label><input asp-for="Form.BildirimAktifMi" type="checkbox" /> Bildirim aktif mi</label></div>
            <div class="form-field"><label><input asp-for="Form.OtomatikTaksitDusur" type="checkbox" /> Ödeme yapıldığında kalan taksidi otomatik azalt</label></div>
            <div class="form-field"><label><input asp-for="Form.AktifMi" type="checkbox" /> Aktif mi</label></div>
            <div class="form-actions-row"><button type="submit" class="btn btn-primary">Ödeme Planı Oluştur</button></div>
        </form>
    </section>
</div>