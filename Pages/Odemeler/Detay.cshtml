@page "{id:int}"
@using MuhasebeTakip2.App.Models
@using MuhasebeTakip2.App.Services
@model MuhasebeTakip2.App.Pages.Odemeler.DetayModel
@{
    ViewData["Title"] = "Ödeme Detayı";
    var odeme = Model.Odeme!;
    var tamamlandi = OdemePlanlamaService.TamamlanmisMi(odeme);
}

@functions {
    private static string HareketAciklama(string? aciklama)
    {
        return aciklama switch
        {
            "Ã–deme yapÄ±ldÄ± olarak iÅŸaretlendi." => "Ödeme yapıldı olarak işaretlendi.",
            "Ãƒâ€“deme yapÃ„Â±ldÃ„Â± olarak iÃ…Å¸aretlendi." => "Ödeme yapıldı olarak işaretlendi.",
            _ => aciklama ?? ""
        };
    }
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">@odeme.OdemeTuru.Metin()</span>
            <h1>@odeme.OdemeAdi</h1>
            <p>@(string.IsNullOrWhiteSpace(odeme.Aciklama) ? "Ödeme planı detayı" : odeme.Aciklama)</p>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-outline-dark" asp-page="/Odemeler/Duzenle" asp-route-id="@odeme.Id">Düzenle</a>
            <a class="btn btn-outline-dark" href="/Odemeler">Liste</a>
            @if (odeme.AktifMi && !tamamlandi)
            {
                <form method="post" asp-page="/Odemeler/Index" asp-page-handler="OdemeYapildi" class="inline-form" onsubmit="return confirm('Bu ödeme bu ay için yapıldı olarak işaretlenecek. Devam edilsin mi?');">
                    <input type="hidden" name="id" value="@odeme.Id" />
                    <button type="submit" class="btn btn-primary">Ödeme Yapıldı</button>
                </form>
            }
            <form method="post" asp-page-handler="Sil" asp-route-id="@odeme.Id" class="inline-form" onsubmit="return confirm('Bu ödeme planı ve ödeme geçmişi silinecek. Devam edilsin mi?');">
                <button type="submit" class="btn btn-outline-danger">Sil</button>
            </form>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }
    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }

    @if (tamamlandi)
    {
        <section class="dashboard-panel payment-completed-panel">
            <div class="panel-title-row">
                <div>
                    <h2>Ödeme tamamlandı</h2>
                    <p>Tüm taksitler ödendi.</p>
                </div>
            </div>
            <div class="summary-grid">
                <article><span>Tamamlanma Tarihi</span><strong>@(odeme.TamamlanmaTarihi?.ToString("dd.MM.yyyy") ?? "-")</strong></article>
                <article><span>Toplam Taksit</span><strong>@odeme.ToplamTaksitSayisi</strong></article>
                <article><span>Toplam Ödenen Tutar</span><strong>@Model.ToplamOdenenTutar.ToString("N2") TL</strong></article>
                <article><span>İlk Ödeme Tarihi</span><strong>@odeme.IlkOdemeTarihi.ToString("dd.MM.yyyy")</strong></article>
                <article><span>Son Ödeme Hareketi</span><strong>@(Model.SonOdemeHareketiTarihi?.ToString("dd.MM.yyyy") ?? "-")</strong></article>
            </div>
        </section>
    }

    <section class="metric-grid">
        <article class="metric-card"><span>Aylık Tutar</span><strong>@odeme.AylikOdemeTutari.ToString("N2") TL</strong></article>
        <article class="metric-card"><span>Kalan Taksit</span><strong>@odeme.KalanTaksitSayisi</strong></article>
        <article class="metric-card"><span>Kalan Toplam Borç</span><strong>@odeme.KalanToplamTutar.ToString("N2") TL</strong></article>
        <article class="metric-card"><span>Durum</span><strong>@Model.Durum.Metin()</strong></article>
    </section>

    <section class="dashboard-content-grid">
        <div class="dashboard-stack">
            <section class="dashboard-panel">
                <div class="panel-title-row"><div><h2>Plan Bilgileri</h2><p>Ödeme takvimi ve ayarlar</p></div></div>
                <div class="table-wrap">
                    <table class="modern-table">
                        <tbody>
                            <tr><th>İlk Ödeme Tarihi</th><td>@odeme.IlkOdemeTarihi.ToString("dd.MM.yyyy")</td></tr>
                            @if (!tamamlandi)
                            {
                                <tr><th>Sonraki Ödeme Tarihi</th><td>@(odeme.SonrakiOdemeTarihi?.ToString("dd.MM.yyyy") ?? "-")</td></tr>
                            }
                            <tr><th>Toplam Taksit</th><td>@odeme.ToplamTaksitSayisi</td></tr>
                            <tr><th>Ödeme Günü</th><td>@odeme.OdemeGunu</td></tr>
                            <tr><th>Otomatik Taksit Düşür</th><td>@(odeme.OtomatikTaksitDusur ? "Evet" : "Hayır")</td></tr>
                            <tr><th>Aktif</th><td>@(odeme.AktifMi ? "Evet" : "Hayır")</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="dashboard-panel">
                <div class="panel-title-row"><div><h2>Ödeme Geçmişi</h2><p>En yeniden eskiye</p></div></div>
                <div class="table-wrap">
                    <table class="modern-table">
                        <thead><tr><th>Tarih</th><th>Tutar</th><th>Kalan Taksit</th><th>Kullanıcı</th><th>Açıklama</th></tr></thead>
                        <tbody>
                            @if (Model.Hareketler.Count == 0)
                            {
                                <tr><td colspan="5" class="empty-row">Henüz ödeme hareketi yok.</td></tr>
                            }
                            else
                            {
                                @foreach (var hareket in Model.Hareketler)
                                {
                                    <tr>
                                        <td>@hareket.OdemeTarihi.ToString("dd.MM.yyyy")</td>
                                        <td class="amount-cell">@hareket.Tutar.ToString("N2") TL</td>
                                        <td>@hareket.KalanTaksitSayisi</td>
                                        <td>@(hareket.OlusturanKullaniciAdi ?? "-")</td>
                                        <td>@HareketAciklama(hareket.Aciklama)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="dashboard-panel">
            <div class="panel-title-row"><div><h2>Bildirim Ayarları</h2><p>@(tamamlandi ? "Tamamlanan planda bildirim gösterilmez" : "Program içi uyarı")</p></div></div>
            <div class="summary-grid">
                <article><span>Bildirim</span><strong>@(!tamamlandi && odeme.BildirimAktifMi ? "Aktif" : "Pasif")</strong></article>
                <article><span>Kaç Gün Önce</span><strong>@odeme.BildirimGunu</strong></article>
                <article><span>Bu Ay Ödendi</span><strong>@(Model.BuAyOdendi ? "Evet" : "Hayır")</strong></article>
            </div>
        </aside>
    </section>
</div>
