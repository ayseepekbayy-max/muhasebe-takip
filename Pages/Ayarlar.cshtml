@page
@model MuhasebeTakip2.App.Pages.AyarlarModel
@{
    ViewData["Title"] = "Ayarlar";
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Yönetim</span>
            <h1>Ayarlar</h1>
            <p>Firma bilgileri, logo, kullanıcı ve menü görünürlüğünü buradan yönetin.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Mesaj))
    {
        <div class="app-alert app-alert-success">@Model.Mesaj</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }

    <section class="app-form-panel">
        <div class="panel-title-row">
            <div>
                <h2>Firma Bilgileri ve Logo</h2>
                <p>Bu bilgiler fatura çıktılarında ve belge başlıklarında kullanılır.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.LogoYolu))
            {
                <img class="settings-logo-preview" src="@Model.LogoYolu" alt="Firma logosu" />
            }
        </div>

        <form method="post" asp-page-handler="FirmaGuncelle" enctype="multipart/form-data" class="app-form-grid">
            <div class="form-field form-field-wide"><label asp-for="FirmaAdi">Firma Adı</label><input asp-for="FirmaAdi" /></div>
            <div class="form-field form-field-wide"><label asp-for="Adres">Adres</label><input asp-for="Adres" /></div>
            <div class="form-field"><label asp-for="Telefon">Telefon</label><input asp-for="Telefon" /></div>
            <div class="form-field"><label asp-for="Email">E-posta</label><input asp-for="Email" type="email" /></div>
            <div class="form-field"><label asp-for="VergiDairesi">Vergi Dairesi</label><input asp-for="VergiDairesi" /></div>
            <div class="form-field"><label asp-for="VergiNo">Vergi No</label><input asp-for="VergiNo" /></div>
            <div class="form-field form-field-wide"><label asp-for="LogoDosyasi">Logo</label><input asp-for="LogoDosyasi" type="file" accept=".png,.jpg,.jpeg,.webp" /></div>
            <div class="form-actions-row"><button type="submit" class="btn btn-primary">Firma Bilgilerini Kaydet</button></div>
        </form>
    </section>

    <section class="app-form-panel">
        <div class="panel-title-row"><div><h2>Kullanıcı Bilgileri</h2><p>Kullanıcı adınızı ve şifrenizi güncelleyin.</p></div></div>
        <form method="post" asp-page-handler="KullaniciGuncelle" class="app-form-grid">
            <div class="form-field form-field-wide"><label asp-for="KullaniciAdi">Kullanıcı Adı</label><input asp-for="KullaniciAdi" /></div>
            <div class="form-field"><label asp-for="MevcutSifre">Mevcut Şifre</label><input asp-for="MevcutSifre" type="password" /></div>
            <div class="form-field"><label asp-for="YeniSifre">Yeni Şifre</label><input asp-for="YeniSifre" type="password" /></div>
            <div class="form-field"><label asp-for="YeniSifreTekrar">Yeni Şifre Tekrar</label><input asp-for="YeniSifreTekrar" type="password" /></div>
            <div class="form-actions-row"><button type="submit" class="btn btn-outline-primary">Kullanıcı Bilgilerini Güncelle</button></div>
        </form>
    </section>

    <section class="app-form-panel">
        <div class="panel-title-row"><div><h2>E-posta Bildirim Ayarları</h2><p>Ödemeler için kullanıcı e-posta bildirimlerini yönetin.</p></div></div>
        <form method="post" asp-page-handler="EmailBildirimKaydet" class="app-form-grid">
            <div class="form-field form-field-wide"><label asp-for="KullaniciEmail">Kullanıcı E-postası</label><input asp-for="KullaniciEmail" type="email" /></div>
            <div class="form-field form-field-wide">
                <label><input asp-for="OdemeEmailBildirimiAktifMi" type="checkbox" /> Ödeme e-posta bildirimleri aktif</label>
            </div>
            <div class="form-actions-row"><button type="submit" class="btn btn-primary">E-posta Ayarlarını Kaydet</button></div>
        </form>
        <form method="post" asp-page-handler="TestEpostasi" class="form-actions-row">
            <button type="submit" class="btn btn-outline-primary">Test E-postası Gönder</button>
        </form>
    </section>

    <section class="app-form-panel">
        <div class="panel-title-row"><div><h2>Menü Görünürlüğü</h2><p>Firmanız için hangi kategorilerin görüneceğini seçin.</p></div></div>
        <form method="post" asp-page-handler="MenuKaydet">
            <div class="settings-toggle-grid">
                <label><input asp-for="MenuCariKartlar" type="checkbox" /> Cari Kartlar</label>
                <label><input asp-for="MenuKasa" type="checkbox" /> Kasa</label>
                <label><input asp-for="MenuRaporlar" type="checkbox" /> Raporlar</label>
                <label><input asp-for="MenuOdemeler" type="checkbox" /> Ödemeler</label>
                <label><input asp-for="MenuCalisanlar" type="checkbox" /> Çalışanlar</label>
                <label><input asp-for="MenuMusteriler" type="checkbox" /> Müşteriler</label>
                <label><input asp-for="MenuStoklar" type="checkbox" /> Stok</label>
                <label><input asp-for="MenuMaliyet" type="checkbox" /> Maliyet</label>
                <label><input asp-for="MenuCekler" type="checkbox" /> Çekler</label>
            </div>
            <div class="form-actions-row"><button type="submit" class="btn btn-outline-primary">Menü Ayarlarını Kaydet</button></div>
        </form>
    </section>
</div>
