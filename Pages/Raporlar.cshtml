@page
@model MuhasebeTakip2.App.Pages.RaporlarModel
@{
    ViewData["Title"] = "Raporlar";
    var maxAkis = new[] { Model.SeciliGelir, Model.SeciliGider, Model.BuAyGelir, Model.BuAyGider, 1m }.Max();
    decimal Width(decimal value) => Math.Max(4, Math.Round((value / maxAkis) * 100, 0));
}

<div class="app-page reports-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Finans Raporları</span>
            <h1>Raporlar</h1>
            <p>Gelir-gider, fatura, stok, cari ve personel özetlerini seçilen dönem için tek ekranda inceleyin.</p>
        </div>

        <div class="app-page-actions">
            <a class="btn btn-outline-success"
               asp-page-handler="DisaAktar"
               asp-route-BaslangicTarihi="@Model.SeciliBaslangic.ToString("yyyy-MM-dd")"
               asp-route-BitisTarihi="@Model.SeciliBitis.ToString("yyyy-MM-dd")">Excel İndir</a>
            <a class="btn btn-outline-dark" href="/">Kontrol Paneli</a>
        </div>
    </section>

    <section class="rapor-filter-panel">
        <div class="panel-title-row">
            <div>
                <h2>Tarih Aralığı</h2>
                <p>@Model.SeciliBaslangic.ToString("dd.MM.yyyy") - @Model.SeciliBitis.ToString("dd.MM.yyyy") dönemi</p>
            </div>
        </div>

        <form method="get" class="app-form-grid rapor-filter-grid">
            <div class="form-field">
                <label asp-for="BaslangicTarihi">Başlangıç Tarihi</label>
                <input asp-for="BaslangicTarihi" type="date" />
            </div>
            <div class="form-field">
                <label asp-for="BitisTarihi">Bitiş Tarihi</label>
                <input asp-for="BitisTarihi" type="date" />
            </div>
            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a class="btn btn-outline-dark" asp-page="/Raporlar" asp-route-Hizli="bugun">Bugün</a>
                <a class="btn btn-outline-dark" asp-page="/Raporlar" asp-route-Hizli="bu-ay">Bu Ay</a>
                <a class="btn btn-outline-dark" asp-page="/Raporlar" asp-route-Hizli="gecen-ay">Geçen Ay</a>
            </div>
        </form>
    </section>

    <section class="rapor-metric-grid">
        <article class="metric-card metric-card-positive">
            <span>Bugünkü Gelir</span>
            <strong>@Model.BugunkuGelir.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Bugünkü Gider</span>
            <strong>@Model.BugunkuGider.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Bu Ay Gelir</span>
            <strong>@Model.BuAyGelir.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Bu Ay Gider</span>
            <strong>@Model.BuAyGider.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card @(Model.BuAyKarZarar < 0 ? "metric-card-negative" : "metric-card-positive")">
            <span>Bu Ay Kâr/Zarar</span>
            <strong>@Model.BuAyKarZarar.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card">
            <span>Toplam Stok Değeri</span>
            <strong>@Model.ToplamStokDegeri.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-warning">
            <span>Bekleyen Fatura</span>
            <strong>@Model.BekleyenFaturaTutari.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Personel Gideri</span>
            <strong>@Model.PersonelGideri.ToString("N2") ₺</strong>
        </article>
    </section>

    <section class="dashboard-content-grid reports-grid">
        <div class="dashboard-stack">
            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Gelir-Gider Karşılaştırması</h2>
                        <p>Seçilen tarih aralığına göre kasa giriş ve çıkış özeti</p>
                    </div>
                </div>

                <div class="report-bars">
                    <div class="report-bar-row">
                        <span>Gelir</span>
                        <div><i style="width:@Width(Model.SeciliGelir)%"></i></div>
                        <strong>@Model.SeciliGelir.ToString("N2") ₺</strong>
                    </div>
                    <div class="report-bar-row danger">
                        <span>Gider</span>
                        <div><i style="width:@Width(Model.SeciliGider)%"></i></div>
                        <strong>@Model.SeciliGider.ToString("N2") ₺</strong>
                    </div>
                    <div class="report-bar-row @(Model.SeciliNet < 0 ? "danger" : "")">
                        <span>Net Sonuç</span>
                        <div><i style="width:@Width(Math.Abs(Model.SeciliNet))%"></i></div>
                        <strong>@Model.SeciliNet.ToString("N2") ₺</strong>
                    </div>
                </div>

                <div class="summary-grid report-summary-grid">
                    <article>
                        <span>Seçilen Gelir</span>
                        <strong>@Model.SeciliGelir.ToString("N2") ₺</strong>
                    </article>
                    <article>
                        <span>Seçilen Gider</span>
                        <strong>@Model.SeciliGider.ToString("N2") ₺</strong>
                    </article>
                    <article>
                        <span>Net Sonuç</span>
                        <strong class="@(Model.SeciliNet < 0 ? "amount-expense" : "amount-income")">@Model.SeciliNet.ToString("N2") ₺</strong>
                    </article>
                    <article>
                        <span>Dönem</span>
                        <strong>@((Model.SeciliBitis - Model.SeciliBaslangic).Days + 1) gün</strong>
                    </article>
                </div>
            </section>

            <section class="reports-panel-grid">
                <article class="dashboard-panel">
                    <div class="panel-title-row">
                        <div>
                            <h2>En Çok Tahsilat Yapılan 5 Cari</h2>
                            <p>Seçilen dönemde kasa girişi en yüksek kayıtlar</p>
                        </div>
                    </div>
                    <div class="report-list">
                        @if (Model.EnCokTahsilatYapilanlar.Count == 0)
                        {
                            <div class="empty-state">Bu dönemde tahsilat kaydı yok.</div>
                        }
                        else
                        {
                            @foreach (var item in Model.EnCokTahsilatYapilanlar)
                            {
                                <div class="report-list-row">
                                    <div><strong>@item.Ad</strong><span>@item.Adet işlem</span></div>
                                    <b class="amount-income">@item.Tutar.ToString("N2") ₺</b>
                                </div>
                            }
                        }
                    </div>
                </article>

                <article class="dashboard-panel">
                    <div class="panel-title-row">
                        <div>
                            <h2>En Çok Ödeme Yapılan 5 Satıcı</h2>
                            <p>Seçilen dönemde kasa çıkışı en yüksek kayıtlar</p>
                        </div>
                    </div>
                    <div class="report-list">
                        @if (Model.EnCokOdemeYapilanlar.Count == 0)
                        {
                            <div class="empty-state">Bu dönemde ödeme kaydı yok.</div>
                        }
                        else
                        {
                            @foreach (var item in Model.EnCokOdemeYapilanlar)
                            {
                                <div class="report-list-row">
                                    <div><strong>@item.Ad</strong><span>@item.Adet işlem</span></div>
                                    <b class="amount-expense">@item.Tutar.ToString("N2") ₺</b>
                                </div>
                            }
                        }
                    </div>
                </article>
            </section>

            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>En Çok Hareket Gören 5 Stok Ürünü</h2>
                        <p>Seçilen dönemde giriş/çıkış sayısına göre sıralama</p>
                    </div>
                </div>
                <div class="table-wrap">
                    <table class="modern-table report-table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Kod</th>
                                <th>Giriş</th>
                                <th>Çıkış</th>
                                <th>Hareket</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.EnCokHareketGorenStoklar.Count == 0)
                            {
                                <tr><td colspan="5" class="empty-row">Bu dönemde stok hareketi yok.</td></tr>
                            }
                            else
                            {
                                @foreach (var stok in Model.EnCokHareketGorenStoklar)
                                {
                                    <tr>
                                        <td><strong>@stok.Ad</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(stok.Kod) ? "-" : stok.Kod)</td>
                                        <td>@stok.Giris.ToString("N2")</td>
                                        <td>@stok.Cikis.ToString("N2")</td>
                                        <td><span class="status-pill status-pill-partial">@stok.HareketSayisi</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="dashboard-stack">
            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Personel Özeti</h2>
                        <p>Seçilen dönemde maaş ve avans hareketleri</p>
                    </div>
                </div>

                <div class="report-total-card">
                    <span>Net Personel Gideri</span>
                    <strong>@Model.NetPersonelGideri.ToString("N2") ₺</strong>
                </div>

                <div class="summary-grid report-summary-grid">
                    <article>
                        <span>Toplam Maaş</span>
                        <strong>@Model.ToplamMaasOdemesi.ToString("N2") ₺</strong>
                    </article>
                    <article>
                        <span>Toplam Avans</span>
                        <strong>@Model.ToplamAvans.ToString("N2") ₺</strong>
                    </article>
                </div>
            </section>

            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Fatura Özeti</h2>
                        <p>Seçilen dönemde fatura durum dağılımı</p>
                    </div>
                </div>

                <div class="report-list">
                    <div class="report-list-row">
                        <div><strong>Bekleyen Faturalar</strong><span>@Model.BekleyenFaturaSayisi adet</span></div>
                        <b class="amount-expense">@Model.BekleyenFaturaTutari.ToString("N2") ₺</b>
                    </div>
                    <div class="report-list-row">
                        <div><strong>Ödenmiş Faturalar</strong><span>@Model.OdenmisFaturaSayisi adet</span></div>
                        <b class="amount-income">@Model.OdenmisFaturaTutari.ToString("N2") ₺</b>
                    </div>
                    <div class="report-list-row">
                        <div><strong>İptal Faturalar</strong><span>@Model.IptalFaturaSayisi adet</span></div>
                        <b>@Model.IptalFaturaTutari.ToString("N2") ₺</b>
                    </div>
                    <div class="report-list-row report-list-row-total">
                        <div><strong>Toplam Fatura Tutarı</strong><span>Genel toplam</span></div>
                        <b>@Model.ToplamFaturaTutari.ToString("N2") ₺</b>
                    </div>
                </div>
            </section>
        </aside>
    </section>
</div>
