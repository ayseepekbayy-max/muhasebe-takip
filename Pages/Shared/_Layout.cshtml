@using Microsoft.EntityFrameworkCore
@using MuhasebeTakip2.App.Data
@using MuhasebeTakip2.App.Services
@inject AppDbContext LayoutDb
@inject IOdemeBildirimService OdemeBildirimService
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmova ERP</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MuhasebeTakip2.App.styles.css" asp-append-version="true" />
</head>
<body autocomplete="off">
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("input").forEach(x => x.setAttribute("autocomplete", "off"));
        });
    </script>

    @{
        var rol = (Context.Session.GetString("Rol") ?? "").Trim().ToLower();
        var path = Context.Request.Path.Value?.ToLower() ?? "";
        var loginSayfasiMi = path == "/login";
        var firmaAdi = Context.Session.GetString("FirmaAdi");
        var kullaniciAdi = Context.Session.GetString("KullaniciAdi");
        var demoMode = Context.Session.GetString("DemoMode") == "1";
        var marka = string.IsNullOrWhiteSpace(firmaAdi) ? "Firmova ERP" : firmaAdi;
        var firmaId = Context.Session.GetInt32("FirmaId");
        var kullaniciId = Context.Session.GetInt32("KullaniciId");
        var bugun = DateTime.UtcNow.Date;
        var odemeBildirimSayisi = 0;
        if (firmaId != null)
        {
            odemeBildirimSayisi = await OdemeBildirimService.AktifBildirimSayisiAsync(firmaId.Value, kullaniciId, bugun);
        }
    }

    @if (!loginSayfasiMi)
    {
        <header class="app-header">
            <nav class="navbar navbar-expand-lg app-navbar">
                <div class="container-fluid app-nav-container">
                    <a class="navbar-brand app-brand" asp-area="" asp-page="/Index">
                        <span class="app-brand-mark">F</span>
                        <span class="app-brand-text">@marka</span>
                    </a>

                    <button class="navbar-toggler app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü aç veya kapat">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="mainNavbar" class="navbar-collapse collapse app-nav-collapse">
                        <ul class="navbar-nav app-nav-list">
                            @if (Context.Session.GetString("MenuCariKartlar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/CariKartlar">Cari</a></li>
                            }

                            @if (Context.Session.GetString("MenuKasa") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Kasa</a></li>
                            }

                            <li class="nav-item"><a class="nav-link" href="/Faturalar">Faturalar</a></li>

                            @if (Context.Session.GetString("MenuStoklar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Stoklar">Stok</a></li>
                            }

                            @if (Context.Session.GetString("MenuRaporlar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Raporlar">Raporlar</a></li>
                            }

                            @if (Context.Session.GetString("MenuOdemeler") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Odemeler">Ödemeler</a></li>
                            }

                            <li class="nav-item dropdown app-nav-dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">İşletme</a>
                                <ul class="dropdown-menu app-dropdown-menu">
                                    @if (Context.Session.GetString("MenuCalisanlar") != "0")
                                    {
                                        <li><a class="dropdown-item" href="/Calisanlar">Çalışanlar</a></li>
                                    }
                                    @if (Context.Session.GetString("MenuMusteriler") != "0")
                                    {
                                        <li><a class="dropdown-item" href="/Musteriler">Müşteriler</a></li>
                                    }
                                    @if (Context.Session.GetString("MenuMaliyet") != "0")
                                    {
                                        <li><a class="dropdown-item" href="/Maliyet">Maliyet</a></li>
                                    }
                                    @if (Context.Session.GetString("MenuCekler") != "0")
                                    {
                                        <li><a class="dropdown-item" href="/Cekler">Çekler</a></li>
                                    }
                                </ul>
                            </li>

                            <li class="nav-item dropdown app-nav-dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Araçlar</a>
                                <ul class="dropdown-menu app-dropdown-menu">
                                    <li><a class="dropdown-item" href="/Ara">Genel Arama</a></li>
                                    <li><a class="dropdown-item" href="/Araclar/ExcelIceAktar">Excel İçe Aktar</a></li>
                                    <li><a class="dropdown-item" href="/Araclar/Yedekleme">Yedekleme</a></li>
                                    <li><a class="dropdown-item" href="/IslemGecmisi">İşlem Geçmişi</a></li>
                                    <li><a class="dropdown-item" href="/AiAsistan">AI Asistan</a></li>
                                    @if (rol == "superadmin" || rol == "admin")
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="/SuperAdmin/Index">Süper Admin</a></li>
                                    }
                                </ul>
                            </li>
                        </ul>

                        <form class="app-global-search" method="get" action="/Ara">
                            <input name="q" type="search" placeholder="Ara" />
                        </form>

                        <div class="app-top-actions">
                            @if (rol == "superadmin" || rol == "admin")
                            {
                                <div class="dropdown yonetici-notlari" data-bs-auto-close="outside">
                                    <button class="app-top-btn yonetici-notlari-toggle" type="button" data-bs-toggle="dropdown"
                                            aria-expanded="false" title="Yönetici notları" aria-label="Yönetici notlarını aç">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M4 3h11a2 2 0 0 1 2 2v5l-2 2V5H6v14h9v-3l2-2v5a2 2 0 0 1-2 2H4V3Zm15.7 6.3a1 1 0 0 1 0 1.4l-6.8 6.8-2.4.5.5-2.4 6.8-6.8a1 1 0 0 1 1.4 0l.5.5Z" />
                                        </svg>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end yonetici-notlari-panel">
                                        <div class="yonetici-notlari-baslik">Yönetici Notları</div>
                                        <form id="yonetici-notu-form" class="yonetici-notu-form">
                                            @Html.AntiForgeryToken()
                                            <label for="yonetici-notu-metni" class="visually-hidden">Yeni Not</label>
                                            <textarea id="yonetici-notu-metni" name="notMetni" maxlength="500" rows="3"
                                                      placeholder="Yeni Not" required></textarea>
                                            <div class="yonetici-notu-form-alt">
                                                <small><span id="yonetici-notu-karakter">0</span>/500</small>
                                                <button type="submit" class="btn btn-sm btn-primary">Ekle</button>
                                            </div>
                                        </form>
                                        <div id="yonetici-notlari-mesaj" class="yonetici-notlari-mesaj" role="status"></div>
                                        <div id="yonetici-notlari-liste" class="yonetici-notlari-liste">
                                            <div class="yonetici-notlari-bos">Notlar yükleniyor…</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (odemeBildirimSayisi > 0)
                            {
                                <a class="app-top-btn" href="/#odeme-bildirimleri" title="Yaklaşan veya geciken ödeme ve çekler">Bildirim <span class="badge bg-danger">@odemeBildirimSayisi</span></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(kullaniciAdi))
                            {
                                <a class="app-top-btn" href="/Ayarlar">Ayarlar</a>
                                <a class="app-top-btn app-top-btn-danger" href="/Logout">Çıkış</a>
                            }
                            else
                            {
                                <a class="app-top-btn" href="/Login">Giriş</a>
                                <a class="app-top-btn" href="/Register">Kayıt Ol</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        @if (demoMode)
        {
            <div class="demo-mode-banner">
                <span>Demo modundasınız. Veriler örnektir ve değiştirilemez.</span>
                <a href="/Register">Kendi hesabını oluştur</a>
            </div>
        }
        @if (demoMode && Context.Request.Query["demoReadonly"] == "1")
        {
            <div class="demo-readonly-alert">
                Demo modunda veri ekleme, düzenleme ve silme işlemleri kapalıdır.
            </div>
        }
    }

    <div class="@(loginSayfasiMi ? "" : "container-fluid app-main-container")" style="@(loginSayfasiMi ? "width:100%; max-width:none; padding:0; margin:0;" : "")">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    @if (!loginSayfasiMi)
    {
        <footer class="app-footer">
            <div class="container-fluid app-footer-inner">
                <span>&copy; 2026 Firmova ERP</span>
                <span>Muhasebe, kasa ve işletme takibi</span>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!loginSayfasiMi && (rol == "superadmin" || rol == "admin"))
    {
        <script>
            (() => {
                const kapsayici = document.querySelector(".yonetici-notlari");
                if (!kapsayici) return;

                const form = document.getElementById("yonetici-notu-form");
                const metin = document.getElementById("yonetici-notu-metni");
                const karakter = document.getElementById("yonetici-notu-karakter");
                const liste = document.getElementById("yonetici-notlari-liste");
                const mesaj = document.getElementById("yonetici-notlari-mesaj");
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                const mesajGoster = (deger, hata = false) => {
                    mesaj.textContent = deger || "";
                    mesaj.classList.toggle("hata", hata);
                };

                const tarihYaz = deger => new Intl.DateTimeFormat("tr-TR", {
                    day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit"
                }).format(new Date(deger));

                const kalanSureYaz = son => {
                    const dakika = Math.max(0, Math.ceil((new Date(son).getTime() - Date.now()) / 60000));
                    return dakika >= 60 ? `${Math.floor(dakika / 60)} sa ${dakika % 60} dk kaldı` : `${dakika} dk kaldı`;
                };

                const notlariCiz = notlar => {
                    liste.replaceChildren();
                    const aktifNotlar = notlar.filter(not => new Date(not.sonKullanmaTarihi).getTime() > Date.now());
                    if (aktifNotlar.length === 0) {
                        const bos = document.createElement("div");
                        bos.className = "yonetici-notlari-bos";
                        bos.textContent = "Aktif not yok.";
                        liste.appendChild(bos);
                        return;
                    }

                    aktifNotlar.forEach(not => {
                        const kart = document.createElement("div");
                        kart.className = "yonetici-notu-kart";
                        kart.dataset.sonKullanmaTarihi = not.sonKullanmaTarihi;

                        const icerik = document.createElement("div");
                        icerik.className = "yonetici-notu-icerik";
                        icerik.textContent = not.notMetni;

                        const alt = document.createElement("div");
                        alt.className = "yonetici-notu-alt";
                        const zaman = document.createElement("span");
                        zaman.textContent = `${tarihYaz(not.olusturmaTarihi)} · ${kalanSureYaz(not.sonKullanmaTarihi)}`;

                        const sil = document.createElement("button");
                        sil.type = "button";
                        sil.className = "yonetici-notu-sil";
                        sil.dataset.id = not.id;
                        sil.title = "Notu sil";
                        sil.setAttribute("aria-label", "Notu sil");
                        sil.textContent = "Sil";

                        alt.append(zaman, sil);
                        kart.append(icerik, alt);
                        liste.appendChild(kart);
                    });
                };

                const notlariYukle = async () => {
                    mesajGoster("");
                    try {
                        const cevap = await fetch("/YoneticiNotlari?handler=Liste", { credentials: "same-origin" });
                        if (!cevap.ok) throw new Error();
                        notlariCiz(await cevap.json());
                    } catch {
                        liste.replaceChildren();
                        mesajGoster("Notlar yüklenemedi.", true);
                    }
                };

                kapsayici.addEventListener("shown.bs.dropdown", notlariYukle);
                metin.addEventListener("input", () => karakter.textContent = metin.value.length);

                form.addEventListener("submit", async olay => {
                    olay.preventDefault();
                    const notMetni = metin.value.trim();
                    if (!notMetni) {
                        mesajGoster("Not metni boş olamaz.", true);
                        return;
                    }

                    const veri = new URLSearchParams({ notMetni });
                    try {
                        const cevap = await fetch("/YoneticiNotlari?handler=Ekle", {
                            method: "POST",
                            credentials: "same-origin",
                            headers: { "RequestVerificationToken": token, "Content-Type": "application/x-www-form-urlencoded" },
                            body: veri
                        });
                        const sonuc = await cevap.json().catch(() => ({}));
                        if (!cevap.ok) throw new Error(sonuc.mesaj || "Not eklenemedi.");
                        metin.value = "";
                        karakter.textContent = "0";
                        mesajGoster(sonuc.mesaj);
                        await notlariYukle();
                    } catch (hata) {
                        mesajGoster(hata.message || "Not eklenemedi.", true);
                    }
                });

                liste.addEventListener("click", async olay => {
                    const sil = olay.target.closest(".yonetici-notu-sil");
                    if (!sil) return;
                    try {
                        const cevap = await fetch(`/YoneticiNotlari?handler=Sil&id=${encodeURIComponent(sil.dataset.id)}`, {
                            method: "POST", credentials: "same-origin", headers: { "RequestVerificationToken": token }
                        });
                        const sonuc = await cevap.json().catch(() => ({}));
                        if (!cevap.ok) throw new Error(sonuc.mesaj || "Not silinemedi.");
                        mesajGoster(sonuc.mesaj);
                        await notlariYukle();
                    } catch (hata) {
                        mesajGoster(hata.message || "Not silinemedi.", true);
                    }
                });

                window.setInterval(() => {
                    if (!kapsayici.querySelector(".dropdown-menu.show")) return;
                    liste.querySelectorAll(".yonetici-notu-kart").forEach(kart => {
                        if (new Date(kart.dataset.sonKullanmaTarihi).getTime() <= Date.now()) kart.remove();
                    });
                    if (!liste.querySelector(".yonetici-notu-kart")) notlariCiz([]);
                }, 30000);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
