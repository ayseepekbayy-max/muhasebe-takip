<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmova ERP</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MuhasebeTakip2.App.styles.css" asp-append-version="true" />
</head>
<body autocomplete="off">
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("input").forEach(x => x.setAttribute("autocomplete", "off"));
        });
    </script>

    @{
        var rol = (Context.Session.GetString("Rol") ?? "").Trim().ToLower();
        var path = Context.Request.Path.Value?.ToLower() ?? "";
        var loginSayfasiMi = path == "/login";
        var firmaAdi = Context.Session.GetString("FirmaAdi");
        var kullaniciAdi = Context.Session.GetString("KullaniciAdi");
        var marka = string.IsNullOrWhiteSpace(firmaAdi) ? "Firmova ERP" : firmaAdi;
    }

    @if (!loginSayfasiMi)
    {
        <header class="app-header">
            <nav class="navbar navbar-expand-lg app-navbar">
                <div class="container-fluid app-nav-container">
                    <a class="navbar-brand app-brand" asp-area="" asp-page="/Index">
                        <span class="app-brand-mark">F</span>
                        <span class="app-brand-text">@marka</span>
                    </a>

                    <button class="navbar-toggler app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü aç veya kapat">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="mainNavbar" class="navbar-collapse collapse app-nav-collapse">
                        <ul class="navbar-nav app-nav-list">
                            @if (Context.Session.GetString("MenuCariKartlar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/CariKartlar">Cari Kartlar</a></li>
                            }

                            @if (Context.Session.GetString("MenuKasa") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Kasa</a></li>
                            }

                            @if (Context.Session.GetString("MenuRaporlar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Raporlar">Raporlar</a></li>
                            }

                            @if (Context.Session.GetString("MenuCalisanlar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Calisanlar">Çalışanlar</a></li>
                            }

                            @if (Context.Session.GetString("MenuMusteriler") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Musteriler">Müşteriler</a></li>
                            }

                            @if (Context.Session.GetString("MenuStoklar") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Stoklar">Stok</a></li>
                            }

                            @if (Context.Session.GetString("MenuMaliyet") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Maliyet">Maliyet</a></li>
                            }

                            <li class="nav-item"><a class="nav-link" href="/AiAsistan">AI Asistan</a></li>

                            @if (Context.Session.GetString("MenuCekler") != "0")
                            {
                                <li class="nav-item"><a class="nav-link" href="/Cekler">Çekler</a></li>
                            }

                            @if (rol == "superadmin")
                            {
                                <li class="nav-item"><a class="nav-link" href="/SuperAdmin/Index">Süper Admin</a></li>
                            }
                        </ul>

                        <div class="app-top-actions">
                            @if (!string.IsNullOrWhiteSpace(firmaAdi))
                            {
                                <span class="app-firma-badge">@firmaAdi</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(kullaniciAdi))
                            {
                                <a class="app-top-btn" href="/Ayarlar">Ayarlar</a>
                                <a class="app-top-btn app-top-btn-danger" href="/Logout">Çıkış</a>
                            }
                            else
                            {
                                <a class="app-top-btn" href="/Login">Giriş</a>
                                <a class="app-top-btn" href="/Register">Kayıt Ol</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(loginSayfasiMi ? "" : "container-fluid app-main-container")" style="@(loginSayfasiMi ? "width:100%; max-width:none; padding:0; margin:0;" : "")">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    @if (!loginSayfasiMi)
    {
        <footer class="app-footer">
            <div class="container-fluid app-footer-inner">
                <span>&copy; 2026 Firmova ERP</span>
                <span>Muhasebe, kasa ve işletme takibi</span>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
