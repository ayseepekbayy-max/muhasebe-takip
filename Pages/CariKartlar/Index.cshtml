@page
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.CariKartlar.IndexModel
@{
    ViewData["Title"] = "Cari Kartlar";
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Cari Yönetimi</span>
            <h1>Cari Kartlar</h1>
            <p>Alıcı ve satıcı kartlarını hızlıca oluşturun, arayın ve detay hareketlerine geçin.</p>
        </div>

        <div class="app-page-actions">
            <form method="post" asp-page-handler="DisaAktar">
                <button type="submit" class="btn btn-outline-success">Excel İndir</button>
            </form>
            <a class="btn btn-outline-dark" href="/">Kasa</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }

    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="app-form-panel">
        <div class="panel-title-row">
            <div>
                <h2>Yeni Cari Ekle</h2>
                <p>Ünvan, tip ve iletişim bilgilerini girerek yeni cari kart oluşturun.</p>
            </div>
        </div>

        <form method="post" asp-page-handler="Ekle" class="app-form-grid">
            <div class="form-field form-field-wide">
                <label asp-for="YeniCari.Unvan">Ünvan</label>
                <input asp-for="YeniCari.Unvan" />
            </div>

            <div class="form-field">
                <label asp-for="YeniCari.Tip">Tip</label>
                <select asp-for="YeniCari.Tip">
                    <option value="@((int)CariTip.Alici)">Alıcı</option>
                    <option value="@((int)CariTip.Satici)">Satıcı</option>
                </select>
            </div>

            <div class="form-field">
                <label asp-for="YeniCari.Telefon">Telefon</label>
                <input asp-for="YeniCari.Telefon" />
            </div>

            <div class="form-field">
                <label asp-for="YeniCari.VergiNo">Vergi No</label>
                <input asp-for="YeniCari.VergiNo" />
            </div>

            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Cari Ekle</button>
            </div>
        </form>
    </section>

    <section class="app-filter-bar">
        <div class="form-field">
            <label for="cariSearch">Cari ara</label>
            <input id="cariSearch" type="search" placeholder="Ünvan veya telefon yazın" data-table-search="cari-row" />
        </div>
        <div class="filter-summary">
            <strong>@(Model.Alicilar.Count + Model.Saticilar.Count)</strong>
            <span>toplam cari</span>
        </div>
    </section>

    <section class="two-column-grid">
        <div class="dashboard-panel">
            <div class="panel-title-row">
                <div>
                    <h2>Alıcılar</h2>
                    <p>@Model.Alicilar.Count kayıt</p>
                </div>
            </div>

            <div class="table-wrap">
                <table class="modern-table compact-table">
                    <thead>
                        <tr>
                            <th>Ünvan</th>
                            <th>Telefon</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Alicilar.Count == 0)
                        {
                            <tr><td colspan="3" class="empty-row">Henüz alıcı yok.</td></tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Alicilar)
                            {
                                <tr class="cari-row" data-search="@($"{c.Unvan} {c.Telefon}")">
                                    <td><strong>@c.Unvan</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(c.Telefon) ? "-" : c.Telefon)</td>
                                    <td class="table-actions-cell">
                                        <a class="btn btn-outline-primary btn-sm" href="/CariKartlar/Detay/@c.Id">Detay</a>
                                        <form method="post" asp-page-handler="Sil" class="inline-form" onsubmit="return confirm('Cari silinsin mi?');">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="panel-title-row">
                <div>
                    <h2>Satıcılar</h2>
                    <p>@Model.Saticilar.Count kayıt</p>
                </div>
            </div>

            <div class="table-wrap">
                <table class="modern-table compact-table">
                    <thead>
                        <tr>
                            <th>Ünvan</th>
                            <th>Telefon</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Saticilar.Count == 0)
                        {
                            <tr><td colspan="3" class="empty-row">Henüz satıcı yok.</td></tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Saticilar)
                            {
                                <tr class="cari-row" data-search="@($"{c.Unvan} {c.Telefon}")">
                                    <td><strong>@c.Unvan</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(c.Telefon) ? "-" : c.Telefon)</td>
                                    <td class="table-actions-cell">
                                        <a class="btn btn-outline-primary btn-sm" href="/CariKartlar/Detay/@c.Id">Detay</a>
                                        <form method="post" asp-page-handler="Sil" class="inline-form" onsubmit="return confirm('Cari silinsin mi?');">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-table-search]').forEach(function (input) {
            input.addEventListener('input', function () {
                const targetClass = input.dataset.tableSearch;
                const query = input.value.toLocaleLowerCase('tr-TR').trim();

                document.querySelectorAll('.' + targetClass).forEach(function (row) {
                    const text = (row.dataset.search || row.innerText).toLocaleLowerCase('tr-TR');
                    row.hidden = query.length > 0 && !text.includes(query);
                });
            });
        });
    </script>
}