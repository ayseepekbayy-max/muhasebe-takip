@page "{id:int}"
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.CariKartlar.Detay.IndexModel
@{
    ViewData["Title"] = "Cari Detay";
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Cari Detay</span>
            <h1>@Model.Cari?.Unvan</h1>
            <p>@(Model.Cari?.Tip == CariTip.Alici ? "Alıcı" : "Satıcı") · @(string.IsNullOrWhiteSpace(Model.Cari?.Telefon) ? "Telefon yok" : Model.Cari.Telefon)</p>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-primary" asp-page="/Kasa/HareketEkle" asp-route-cariId="@Model.Cari?.Id">Kasa Hareketi Ekle</a>
            <a class="btn btn-outline-dark" asp-page="/CariKartlar/Ekstre" asp-route-id="@Model.Cari?.Id">Tam Ekstre</a>
            <a class="btn btn-outline-dark" asp-page="/CariKartlar/Index">Cari Kartlar</a>
        </div>
    </section>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger" asp-validation-summary="All"></div>
    }

    <section class="metric-grid">
        <article class="metric-card metric-card-positive">
            <span>Toplam Tahsilat</span>
            <strong>@Model.ToplamGiris.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Toplam Ödeme</span>
            <strong>@Model.ToplamCikis.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card">
            <span>Kasa Bakiyesi</span>
            <strong>@Model.Bakiye.ToString("N2") ₺</strong>
        </article>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row">
            <div><h2>Son Kasa Hareketleri</h2><p>En son 50 tahsilat ve ödeme</p></div>
        </div>
        <div class="table-wrap">
            <table class="modern-table">
                <thead><tr><th>Tarih</th><th>Tür</th><th>Açıklama</th><th>Tutar</th></tr></thead>
                <tbody>
                    @if (Model.Hareketler.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-row">Bu cariye ait kasa hareketi yok.</td></tr>
                    }
                    else
                    {
                        @foreach (var hareket in Model.Hareketler)
                        {
                            <tr>
                                <td>@hareket.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>@(hareket.Tip == HareketTipi.Giris ? "Tahsilat" : "Ödeme")</td>
                                <td>@hareket.Aciklama</td>
                                <td class="amount-cell @(hareket.Tip == HareketTipi.Giris ? "amount-income" : "amount-expense")">
                                    @hareket.Tutar.ToString("N2") ₺
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
