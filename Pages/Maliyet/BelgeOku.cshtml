@page
@model MuhasebeTakip2.App.Pages.Maliyet.BelgeOkuModel

@{
    ViewData["Title"] = "Belgeden Maliyet Oku";
}

<h1>Belgeden Maliyet Oku</h1>

<p>
    <a class="back-btn" href="/Maliyet">← Maliyet</a>
</p>

@if (!string.IsNullOrWhiteSpace(Model.Hata))
{
    <div class="alert error">@Model.Hata</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Mesaj))
{
    <div class="alert ok">@Model.Mesaj</div>
}

<section class="reader-box">
    <div>
        <h2>PDF / Word Dosyası Oku</h2>
        <p>Metin içeren PDF, Word, TXT veya CSV dosyasındaki maliyet satırlarını okuyup arşive kaydedebilirsiniz.</p>
    </div>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Oku" class="upload-form">
        <div>
            <label>Ürün / İş Adı</label>
            <input asp-for="UretimAdi" placeholder="Örn: Mutfak dolabı" />
        </div>

        <div>
            <label>Belge</label>
            <input asp-for="Dosya" type="file" accept=".pdf,.docx,.txt,.csv" />
        </div>

        <button type="submit" class="primary-btn">Belgeyi Oku</button>
    </form>
</section>

<section class="reader-box">
    <div>
        <h2>Fotoğraf / Taranmış Belge OCR</h2>
        <p>Telefon kamerasıyla çekilmiş maliyet kağıdı, fatura görseli veya taranmış resimdeki yazıları okuyabilirsiniz.</p>
    </div>

    <form method="post" asp-page-handler="MetinOku" id="ocrForm" class="upload-form">
        <div>
            <label>Ürün / İş Adı</label>
            <input name="UretimAdi" id="ocrUretimAdi" placeholder="Örn: Mutfak dolabı" />
        </div>

        <div>
            <label>Fotoğraf / Görsel</label>
            <input id="ocrImage" type="file" accept="image/*" capture="environment" />
        </div>

        <textarea asp-for="OkunanMetin" id="ocrText" class="ocr-text"></textarea>

        <button type="button" class="primary-btn" onclick="ocrOku()">OCR ile Tara</button>
    </form>

    <div id="ocrStatus" class="ocr-status">OCR için fotoğraf seçin.</div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.OkunanMetin))
{
    <section class="reader-box">
        <div class="result-title">
            <div>
                <h2>Okunan Maliyet Taslağı</h2>
                <p>Kaydetmeden önce bulunan tutarları kontrol edin. Gerekirse toplam maliyeti elle düzeltebilirsiniz.</p>
            </div>
        </div>

        @if (Model.Kalemler.Any())
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Açıklama</th>
                            <th>Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Kalemler)
                        {
                            <tr>
                                <td>@item.Aciklama</td>
                                <td>@item.ToplamTutar.ToString("N2") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                Otomatik maliyet kalemi bulunamadı. Aşağıdaki toplam maliyeti elle girerek yine de arşive kaydedebilirsiniz.
            </div>
        }

        <form method="post" asp-page-handler="Aktar" class="save-form">
            <input asp-for="OkunanMetin" type="hidden" />

            @for (var i = 0; i < Model.Kalemler.Count; i++)
            {
                <input type="hidden" name="Kalemler[@i].Aciklama" value="@Model.Kalemler[i].Aciklama" />
                <input type="hidden" name="Kalemler[@i].ToplamTutar" value="@Model.Kalemler[i].ToplamTutar" />
            }

            <div>
                <label>Ürün / İş Adı</label>
                <input asp-for="UretimAdi" />
            </div>

            <div>
                <label>Toplam Maliyet</label>
                <input asp-for="ToplamMaliyet" type="number" step="0.01" min="0" />
            </div>

            <button type="submit" class="primary-btn">Üretim Maliyetine Aktar</button>
        </form>

        <form method="post" asp-page-handler="Kaydet" class="direct-save-form">
            <input asp-for="OkunanMetin" type="hidden" />
            <input asp-for="UretimAdi" type="hidden" />
            <input asp-for="ToplamMaliyet" type="hidden" />

            @for (var i = 0; i < Model.Kalemler.Count; i++)
            {
                <input type="hidden" name="Kalemler[@i].Aciklama" value="@Model.Kalemler[i].Aciklama" />
                <input type="hidden" name="Kalemler[@i].ToplamTutar" value="@Model.Kalemler[i].ToplamTutar" />
            }

            <button type="submit" class="secondary-btn">Direkt Arşive Kaydet</button>
        </form>

        <details class="raw-text">
            <summary>Okunan metni göster</summary>
            <pre>@Model.OkunanMetin</pre>
        </details>
    </section>
}

<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

<script>
    async function ocrOku() {
        const fileInput = document.getElementById("ocrImage");
        const status = document.getElementById("ocrStatus");
        const textArea = document.getElementById("ocrText");
        const form = document.getElementById("ocrForm");

        if (!fileInput.files || fileInput.files.length === 0) {
            status.innerText = "Önce bir fotoğraf seçin.";
            return;
        }

        const file = fileInput.files[0];
        status.innerText = "OCR başlatıldı. Fotoğraf okunuyor...";

        try {
            const result = await Tesseract.recognize(
                file,
                "tur+eng",
                {
                    logger: function (m) {
                        if (m.status === "recognizing text" && m.progress) {
                            const percent = Math.round(m.progress * 100);
                            status.innerText = "Yazılar okunuyor: %" + percent;
                        }
                    }
                }
            );

            textArea.value = result.data.text || "";

            if (!textArea.value.trim()) {
                status.innerText = "OCR metin bulamadı. Fotoğrafı daha net çekip tekrar deneyin.";
                return;
            }

            status.innerText = "OCR tamamlandı. Maliyet satırları hazırlanıyor...";
            form.submit();
        } catch (error) {
            status.innerText = "OCR sırasında hata oluştu: " + error;
        }
    }
</script>

<style>
    .back-btn,
    .primary-btn,
    .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .back-btn {
        padding: 10px 14px;
        border: 1px solid #dbe4ee;
        color: #0f172a;
        background: white;
    }

    .primary-btn {
        padding: 12px 16px;
        border: none;
        background: #4f46e5;
        color: white;
        cursor: pointer;
    }

    .secondary-btn {
        padding: 12px 16px;
        border: 1px solid #c7d2fe;
        background: white;
        color: #312e81;
        cursor: pointer;
    }

    .alert {
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        max-width: 1120px;
    }

    .error {
        color: #b42318;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .ok {
        color: #166534;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
    }

    .reader-box {
        border: 1px solid #444;
        border-radius: 10px;
        padding: 22px;
        margin: 16px 0;
        max-width: 1120px;
        background: #f8fafc;
    }

    .reader-box h2 {
        margin: 0 0 8px;
        color: #0f2747;
        font-size: 30px;
        font-weight: 800;
    }

    .reader-box p {
        margin: 0 0 14px;
        color: #475569;
    }

    .upload-form,
    .save-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        align-items: end;
    }

    .direct-save-form {
        margin-top: 10px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        font-weight: 800;
        color: #0f172a;
    }

    input {
        width: 100%;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        background: white;
        font-size: 15px;
    }

    .ocr-text {
        display: none;
    }

    .ocr-status {
        margin-top: 12px;
        padding: 12px;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        background: white;
        color: #475569;
        font-weight: 700;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        margin-bottom: 16px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    th,
    td {
        padding: 10px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    th {
        color: #1e293b;
        border-bottom-color: #64748b;
    }

    .empty-state {
        padding: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        background: white;
        color: #475569;
        margin-bottom: 16px;
    }

    .raw-text {
        margin-top: 16px;
        background: white;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        padding: 12px;
    }

    .raw-text summary {
        cursor: pointer;
        font-weight: 800;
    }

    .raw-text pre {
        white-space: pre-wrap;
        max-height: 360px;
        overflow: auto;
    }

    @@media (max-width: 768px) {
        .primary-btn {
            width: 100%;
        }

        .reader-box h2 {
            font-size: 24px;
        }
    }
</style>
