@page
@model MuhasebeTakip2.App.Pages.Maliyet.BelgeOkuModel

@{
    ViewData["Title"] = "Belgeden Maliyet Oku";
}

<h1>Belgeden Maliyet Oku</h1>

<p>
    <a class="back-btn" href="/Maliyet">← Maliyet</a>
</p>

@if (!string.IsNullOrWhiteSpace(Model.Hata))
{
    <div class="alert error">@Model.Hata</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Mesaj))
{
    <div class="alert ok">@Model.Mesaj</div>
}

<section class="reader-box">
    <div>
        <h2>Dosya Yükle</h2>
        <p>PDF, Word, TXT veya CSV dosyasındaki maliyet satırlarını okuyup arşive kaydedebilirsiniz.</p>
    </div>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Oku" class="upload-form">
        <div>
            <label>Ürün / İş Adı</label>
            <input asp-for="UretimAdi" placeholder="Örn: Mutfak dolabı" />
        </div>

        <div>
            <label>Belge</label>
            <input asp-for="Dosya" type="file" accept=".pdf,.docx,.txt,.csv" />
        </div>

        <button type="submit" class="primary-btn">Belgeyi Oku</button>
    </form>
</section>

<section class="reader-box">
    <h2>OCR Durumu</h2>
    <p>
        Kamera fotoğrafı veya taranmış görsel dosyaları için OCR gerekir. Bu ekranda ilk aşama olarak metin içeren PDF,
        Word ve metin dosyaları okunur. Taranmış görselde metin çıkmazsa OCR modülünü ayrıca aktif edeceğiz.
    </p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.OkunanMetin))
{
    <section class="reader-box">
        <div class="result-title">
            <div>
                <h2>Okunan Maliyet Taslağı</h2>
                <p>Kaydetmeden önce bulunan tutarları kontrol edin. Gerekirse toplam maliyeti elle düzeltebilirsiniz.</p>
            </div>
        </div>

        @if (Model.Kalemler.Any())
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Açıklama</th>
                            <th>Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Kalemler)
                        {
                            <tr>
                                <td>@item.Aciklama</td>
                                <td>@item.ToplamTutar.ToString("N2") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                Otomatik maliyet kalemi bulunamadı. Aşağıdaki toplam maliyeti elle girerek yine de arşive kaydedebilirsiniz.
            </div>
        }

        <form method="post" asp-page-handler="Kaydet" class="save-form">
            <input asp-for="OkunanMetin" type="hidden" />

            @for (var i = 0; i < Model.Kalemler.Count; i++)
            {
                <input type="hidden" name="Kalemler[@i].Aciklama" value="@Model.Kalemler[i].Aciklama" />
                <input type="hidden" name="Kalemler[@i].ToplamTutar" value="@Model.Kalemler[i].ToplamTutar" />
            }

            <div>
                <label>Ürün / İş Adı</label>
                <input asp-for="UretimAdi" />
            </div>

            <div>
                <label>Toplam Maliyet</label>
                <input asp-for="ToplamMaliyet" type="number" step="0.01" min="0" />
            </div>

            <button type="submit" class="primary-btn">Arşive Kaydet</button>
        </form>

        <details class="raw-text">
            <summary>Okunan metni göster</summary>
            <pre>@Model.OkunanMetin</pre>
        </details>
    </section>
}

<style>
    .back-btn,
    .primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .back-btn {
        padding: 10px 14px;
        border: 1px solid #dbe4ee;
        color: #0f172a;
        background: white;
    }

    .primary-btn {
        padding: 12px 16px;
        border: none;
        background: #4f46e5;
        color: white;
        cursor: pointer;
    }

    .alert {
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        max-width: 1120px;
    }

    .error {
        color: #b42318;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .ok {
        color: #166534;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
    }

    .reader-box {
        border: 1px solid #444;
        border-radius: 10px;
        padding: 22px;
        margin: 16px 0;
        max-width: 1120px;
        background: #f8fafc;
    }

    .reader-box h2 {
        margin: 0 0 8px;
        color: #0f2747;
        font-size: 30px;
        font-weight: 800;
    }

    .reader-box p {
        margin: 0 0 14px;
        color: #475569;
    }

    .upload-form,
    .save-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        align-items: end;
    }

    label {
        display: block;
        margin-bottom: 6px;
        font-weight: 800;
        color: #0f172a;
    }

    input {
        width: 100%;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        background: white;
        font-size: 15px;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        margin-bottom: 16px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    th,
    td {
        padding: 10px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    th {
        color: #1e293b;
        border-bottom-color: #64748b;
    }

    .empty-state {
        padding: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        background: white;
        color: #475569;
        margin-bottom: 16px;
    }

    .raw-text {
        margin-top: 16px;
        background: white;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        padding: 12px;
    }

    .raw-text summary {
        cursor: pointer;
        font-weight: 800;
    }

    .raw-text pre {
        white-space: pre-wrap;
        max-height: 360px;
        overflow: auto;
    }

    @@media (max-width: 768px) {
        .primary-btn {
            width: 100%;
        }

        .reader-box h2 {
            font-size: 24px;
        }
    }
</style>
