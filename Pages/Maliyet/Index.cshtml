@page
@model MuhasebeTakip2.App.Pages.Maliyet.IndexModel

@{
    ViewData["Title"] = "Maliyet";
}

<h1>Maliyet</h1>

@if (!string.IsNullOrWhiteSpace(Model.Hata))
{
    <div class="alert error">@Model.Hata</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Mesaj))
{
    <div class="alert ok">@Model.Mesaj</div>
}

<section class="hero-box">
    <div>
        <h2>Üretim Maliyeti Hesapla</h2>
        <p>
            Plaka, bantlama, arkalık, ek malzemeler ve stoktan düşme işlemlerini tek ekranda hesaplayın.
        </p>
    </div>

    <a class="primary-btn" href="/Maliyet/Uretim">
        Yeni Maliyet Hesapla
    </a>
</section>

<section class="summary-grid">
    <div>
        <b>Kayıt Sayısı</b>
        <span>@Model.KayitSayisi</span>
    </div>

    <div>
        <b>Arşiv Toplamı</b>
        <span>@Model.ToplamArsivMaliyeti.ToString("N2") TL</span>
    </div>

    <div>
        <b>Ortalama Birim</b>
        <span>@Model.OrtalamaBirimMaliyet.ToString("N2") TL</span>
    </div>
</section>
<section class="archive-box">
    <div class="archive-title">
        <div>
            <h2>Maliyet Arşivi</h2>
            <p>
                Hesaplanan üretim maliyetleri burada saklanır. AI asistan da bu kayıtları kullanır.
            </p>
        </div>
    </div>

    @if (!Model.MaliyetKayitlari.Any())
    {
        <div class="empty-state">
            Henüz kayıtlı maliyet hesabı yok. İlk kayıt için yeni üretim maliyeti hesaplayın.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Ürün / İş</th>
                        <th>Adet</th>
                        <th>Plaka</th>
                        <th>Bantlama</th>
                        <th>Arkalık</th>
                        <th>Malzeme</th>
                        <th>Toplam</th>
                        <th>Birim</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.MaliyetKayitlari)
                    {
                        <tr>
                            <td>
                                @item.HesapTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                <strong>@item.UretimAdi</strong>
                            </td>

                            <td>
                                @item.UretimAdedi.ToString("N2")
                            </td>

                            <td>
                                @item.PlakaMaliyeti.ToString("N2") TL
                            </td>

                            <td>
                                @item.BantlamaMaliyeti.ToString("N2") TL
                            </td>

                            <td>
                                @item.ArkalikMaliyeti.ToString("N2") TL
                            </td>

                            <td>
                                @item.MalzemeMaliyeti.ToString("N2") TL
                            </td>

                            <td>
                                <strong>@item.ToplamMaliyet.ToString("N2") TL</strong>
                            </td>

                            <td>
                                @item.BirimMaliyet.ToString("N2") TL
                            </td>

                            <td>
                                <form method="post"
                                      asp-page-handler="Sil"
                                      asp-route-id="@item.Id"
                                      onsubmit="return confirm('Bu maliyet kaydı silinsin mi?');">
                                    <button type="submit" class="delete-btn">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<style>
    .alert {
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        max-width: 1120px;
    }

    .error {
        color: #b42318;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

    .ok {
        color: #166534;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
    }

    .hero-box,
    .archive-box {
        border: 1px solid #444;
        border-radius: 10px;
        padding: 22px;
        margin: 16px 0;
        max-width: 1120px;
        background: #f8fafc;
    }

    .hero-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
    }

    .hero-box h2,
    .archive-box h2 {
        margin: 0 0 8px;
        color: #0f2747;
        font-size: 32px;
        font-weight: 800;
    }

    .hero-box p,
    .archive-box p {
        margin: 0;
        color: #475569;
    }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 18px;
        border-radius: 12px;
        background: #4f46e5;
        color: white;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px;
        max-width: 1120px;
        margin-bottom: 16px;
    }

    .summary-grid div {
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        padding: 14px;
        background: white;
    }

    .summary-grid b {
        display: block;
        color: #334155;
        margin-bottom: 8px;
    }

    .summary-grid span {
        font-size: 22px;
        font-weight: 800;
        color: #312e81;
    }

    .archive-title {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .empty-state {
        padding: 18px;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        background: white;
        color: #475569;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        background: white;
    }

    th {
        text-align: left;
        padding: 10px;
        border-bottom: 1px solid #64748b;
        color: #1e293b;
        white-space: nowrap;
    }

    td {
        padding: 10px;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .delete-btn {
        border: 1px solid #fecaca;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 800;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .hero-box {
            flex-direction: column;
            align-items: flex-start;
        }

        .primary-btn {
            width: 100%;
        }

        .hero-box h2,
        .archive-box h2 {
            font-size: 25px;
        }
    }
</style>