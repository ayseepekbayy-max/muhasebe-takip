@page
@model MuhasebeTakip2.App.Pages.AiAsistan.IndexModel
@{
    ViewData["Title"] = "AI Asistan";
}

<div class="ai-page">
    <div class="ai-card">

        <div class="ai-header">
            <div>
                <h2>FirmovaAI</h2>
                <p>Sesli ve yazılı muhasebe asistanı</p>
            </div>

            <div class="ai-status">
                <span></span>
                Aktif
            </div>
        </div>

        <div class="chat-area">

            <div class="message bot">
                <div class="bubble">
                    Merhaba, ben FirmovaAI. Bana kasa, avans, müşteri borcu, çalışan bilgileri veya son hareketleri sorabilirsin.
                </div>
            </div>

            @foreach (var mesaj in Model.Mesajlar)
            {
                if (mesaj.Gonderen == "Kullanici")
                {
                    <div class="message user">
                        <div class="bubble">@mesaj.Metin</div>
                    </div>
                }
                else
                {
                    <div class="message bot">
                        <div class="bubble @(mesaj == Model.Mesajlar.LastOrDefault() ? "son-cevap" : "")">
                            @foreach (var satir in (mesaj.Metin ?? "").Split('\n'))
                            {
                                <div>@satir</div>
                            }
                        </div>
                    </div>
                }
            }

            <div id="aiDusunuyor" class="message bot" style="display:none;">
                <div class="bubble typing">
                    <span></span>
                    <span></span>
                    <span></span>
                    FirmovaAI düşünüyor...
                </div>
            </div>

        </div>

        <form method="post" class="input-area" id="soruFormu">

            <textarea id="soruKutusu"
                      asp-for="Soru"
                      rows="2"
                      placeholder="Örn: Bu ay gelir ne kadar?"
                      class="chat-input"></textarea>

            <div class="button-row">
                <button id="sorButonu" type="submit" class="btn primary">Sor</button>
                <button type="button" onclick="sesliSor()" class="btn">🎤 Sesli Sor</button>
                <button type="button" onclick="cevabiOku()" class="btn">🔊 Oku</button>
                <button type="button" onclick="sesiDurdur()" class="btn danger">⏹ Durdur</button>
                <button type="submit" formaction="?handler=Temizle" class="btn danger">🧹 Sohbeti Temizle</button>
            </div>

            <div id="novaDurum" style="margin-top:10px; font-size:14px; color:#475569;">
                Nova hazırlanıyor...
            </div>

        </form>

    </div>
</div>

<style>
.ai-page {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 30px 12px;
    background: linear-gradient(180deg, #f8fafc, #eef2ff);
}

.ai-card {
    width: 100%;
    max-width: 820px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
    overflow: hidden;
    border: 1px solid #e5e7eb;
}

.ai-header {
    padding: 22px 24px;
    background: linear-gradient(135deg, #312e81, #6366f1);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.ai-header h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
}

.ai-header p {
    margin: 6px 0 0;
    font-size: 14px;
    opacity: 0.9;
}

.ai-status {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.16);
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 13px;
}

.ai-status span {
    width: 9px;
    height: 9px;
    background: #22c55e;
    border-radius: 50%;
}

.chat-area {
    padding: 24px;
    min-height: 340px;
    max-height: 520px;
    overflow-y: auto;
    background: #f8fafc;
}

.message {
    display: flex;
    margin-bottom: 14px;
}

.message.user {
    justify-content: flex-end;
}

.message.bot {
    justify-content: flex-start;
}

.bubble {
    max-width: 75%;
    padding: 13px 15px;
    border-radius: 18px;
    line-height: 1.45;
    font-size: 15px;
}

.message.user .bubble {
    background: #4f46e5;
    color: white;
    border-bottom-right-radius: 6px;
}

.message.bot .bubble {
    background: white;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-bottom-left-radius: 6px;
}

.input-area {
    padding: 18px;
    border-top: 1px solid #e5e7eb;
    background: white;
}

.chat-input {
    width: 100%;
    min-height: 58px;
    resize: vertical;
    padding: 13px 14px;
    border-radius: 16px;
    border: 1px solid #cbd5e1;
    font-size: 15px;
    outline: none;
}

.button-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
}

.btn {
    border: none;
    border-radius: 14px;
    padding: 11px 14px;
    background: #e2e8f0;
    color: #0f172a;
    font-weight: 700;
    cursor: pointer;
}

.btn.primary {
    background: #4f46e5;
    color: white;
}

.btn.danger {
    background: #fee2e2;
    color: #991b1b;
}

.typing {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #475569;
    font-style: italic;
}

.typing span {
    width: 7px;
    height: 7px;
    background: #6366f1;
    border-radius: 50%;
    animation: blink 1.2s infinite;
}

.typing span:nth-child(2) {
    animation-delay: 0.2s;
}

.typing span:nth-child(3) {
    animation-delay: 0.4s;
}

@@keyframes blink {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 1; }
}

@@media (max-width:768px){

    .ai-page{
        padding:14px 8px;
    }

    .ai-header{
        flex-direction:column;
        align-items:flex-start;
        gap:12px;
    }

    .bubble{
        max-width:92%;
    }

    .button-row{
        flex-direction:column;
    }

    .btn{
        width:100%;
    }
}
</style>

<script>

let novaRecognition = null;
let novaDinliyor = false;
let novaAktif = false;
let isSpeaking = false;
let soruGonderiliyor = false;

function novaDurumYaz(metin){

    const durum = document.getElementById("novaDurum");

    if(durum){
        durum.innerText = metin;
    }
}

function chatAltaKaydir(){

    const alan = document.querySelector(".chat-area");

    if(alan){
        alan.scrollTop = alan.scrollHeight;
    }
}

function mesajEkle(tip, metin){

    const alan = document.querySelector(".chat-area");

    if(!alan) return;

    const row = document.createElement("div");
    row.className = tip === "user"
        ? "message user"
        : "message bot";

    const bubble = document.createElement("div");

    bubble.className = tip === "user"
        ? "bubble"
        : "bubble son-cevap";

    if(tip === "user"){

        bubble.innerText = metin;

    } else {

        document.querySelectorAll(".son-cevap")
            .forEach(x => x.classList.remove("son-cevap"));

        (metin || "").split("\n").forEach(x => {

            const d = document.createElement("div");
            d.innerText = x;
            bubble.appendChild(d);
        });
    }

    row.appendChild(bubble);

    alan.appendChild(row);

    chatAltaKaydir();
}

function novaDinlemeyiDurdur(){

    if(novaRecognition){

        try{
            novaRecognition.stop();
        }
        catch{}
    }

    novaRecognition = null;
    novaDinliyor = false;
}

function novaDinlemeyiBaslat(){

    if(isSpeaking || soruGonderiliyor) return;

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    if(!SpeechRecognition){

        novaDurumYaz("Tarayıcı sesli komutu desteklemiyor.");
        return;
    }

    if(novaDinliyor) return;

    try{

        novaRecognition = new SpeechRecognition();

        novaRecognition.lang = "tr-TR";
        novaRecognition.continuous = false;
        novaRecognition.interimResults = false;

        novaRecognition.onstart = function(){

            novaDinliyor = true;

            novaDurumYaz("Nova dinlemede...");
        };

        novaRecognition.onresult = function(e){

            if(isSpeaking || soruGonderiliyor) return;

            const sonIndex = e.results.length - 1;

            let metin =
                e.results[sonIndex][0]
                .transcript
                .toLowerCase()
                .trim();

            const novaDendi =
                metin.includes("hey nova") ||
                metin.includes("ey nova") ||
                metin === "nova";

            if(!novaAktif && novaDendi){

                novaAktif = true;

                novaDurumYaz("Nova aktif.");

                novaCevapVer("Dinliyorum");

                return;
            }

            if(
                novaAktif &&
                metin.length > 3 &&
                !metin.includes("hey nova")
            ){

                soruyuGonder(metin);
            }
        };

        novaRecognition.onerror = function(){

            novaDinliyor = false;
        };

        novaRecognition.onend = function(){

            novaDinliyor = false;

            if(isSpeaking || soruGonderiliyor){
                return;
            }

            setTimeout(() => {

                try{
                    novaDinlemeyiBaslat();
                }
                catch{}

            }, 1500);
        };

        novaRecognition.start();
    }
    catch{

        novaDinliyor = false;
    }
}

function novaCevapVer(metin){

    if (!metin || !metin.trim()) return;

    novaDinlemeyiDurdur();

    speechSynthesis.cancel();

    const t = new SpeechSynthesisUtterance(metin);

    t.lang = "tr-TR";
    t.rate = 0.92;
    t.pitch = 1;

    t.onstart = () => {

        isSpeaking = true;

        novaDurumYaz("🔊 Nova cevap veriyor...");
    };

    t.onend = () => {

        speechSynthesis.cancel();

        isSpeaking = false;
        soruGonderiliyor = false;

        novaDurumYaz("Nova dinlemede...");

        setTimeout(() => {

            if(!novaDinliyor && !isSpeaking){

                try{
                    novaDinlemeyiBaslat();
                }
                catch{}

            }

        }, 2200);
    };

    t.onerror = () => {

        isSpeaking = false;
        soruGonderiliyor = false;

        novaDurumYaz("Sesli okuma başarısız oldu.");
    };

    speechSynthesis.speak(t);
}

async function soruyuGonder(soru){

    const form = document.getElementById("soruFormu");

    if(!form) return;

    soruGonderiliyor = true;

    novaDinlemeyiDurdur();

    mesajEkle("user", soru);

    try{

        const fd = new FormData(form);

        fd.set("Soru", soru);

        const response = await fetch("?handler=Ajax", {
            method: "POST",
            body: fd
        });

        const data = await response.json();

        const cevap =
            data.cevap || "Cevap alınamadı.";

        mesajEkle("bot", cevap);

        setTimeout(() => {

            novaCevapVer(cevap);

        }, 250);
    }
    catch{

        soruGonderiliyor = false;

        novaDurumYaz("Bağlantı hatası.");
    }
}

function sesliSor(){

    novaAktif = true;

    novaDurumYaz("Nova aktif.");

    novaDinlemeyiBaslat();
}

function cevabiOku(){

    const cevap =
        document.querySelector(".son-cevap");

    if(!cevap) return;

    novaCevapVer(cevap.innerText);
}

function sesiDurdur(){

    speechSynthesis.cancel();

    isSpeaking = false;
    soruGonderiliyor = false;

    novaDurumYaz("Nova durduruldu.");

    setTimeout(() => {

        try{
            novaDinlemeyiBaslat();
        }
        catch{}

    }, 1200);
}

window.addEventListener("load", function(){

    soruGonderiliyor = false;

    chatAltaKaydir();

    novaDurumYaz("Nova hazır. 'Hey Nova' diyebilirsin.");

    setTimeout(() => {

        try{
            novaDinlemeyiBaslat();
        }
        catch{}

    }, 1200);
});

document.addEventListener("DOMContentLoaded", function(){

    const form =
        document.getElementById("soruFormu");

    if(form){

        form.addEventListener("submit", function(e){

            const submitter = e.submitter;

            if(
                submitter &&
                submitter.getAttribute("formaction") &&
                submitter.getAttribute("formaction").includes("Temizle")
            ){
                return;
            }

            e.preventDefault();

            const kutu =
                document.getElementById("soruKutusu");

            soruyuGonder(
                kutu ? kutu.value : ""
            );
        });
    }
});

</script>