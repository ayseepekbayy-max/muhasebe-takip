@page
@model MuhasebeTakip2.App.Pages.IslemGecmisi.IndexModel
@{
    ViewData["Title"] = "İşlem Geçmişi";
}

<div class="container-fluid py-4">
    <div class="page-panel mb-3">
        <div>
            <span class="page-eyebrow">Güvenlik ve takip</span>
            <h1>İşlem Geçmişi</h1>
            <p>Kullanıcıların yaptığı değişiklikleri firma bazında inceleyin.</p>
        </div>
    </div>

    <div class="page-panel mb-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label" for="modul">Modül</label>
                <select id="modul" name="Modul" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var modul in Model.Moduller)
                    {
                        <option value="@modul" selected="@(Model.Modul == modul)">@modul</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="islemTuru">İşlem türü</label>
                <select id="islemTuru" name="IslemTuru" class="form-select">
                    <option value="">Tümü</option>
                    <option value="Ekleme" selected="@(Model.IslemTuru == "Ekleme")">Ekleme</option>
                    <option value="Düzenleme" selected="@(Model.IslemTuru == "Düzenleme")">Düzenleme</option>
                    <option value="Silme" selected="@(Model.IslemTuru == "Silme")">Silme</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="kullanici">Kullanıcı</label>
                <input id="kullanici" name="Kullanici" value="@Model.Kullanici" class="form-control" placeholder="Kullanıcı adı ara" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filtrele</button>
                <a href="/IslemGecmisi" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </form>
    </div>

    <div class="page-panel">
        @if (Model.Kayitlar.Count == 0)
        {
            <div class="empty-state">Gösterilecek işlem geçmişi bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle audit-table">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                            <th>Modül</th>
                            <th>İşlem</th>
                            <th>Açıklama</th>
                            <th>Detay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kayit in Model.Kayitlar)
                        {
                            <tr>
                                <td class="text-nowrap">@kayit.Tarih.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>
                                    <strong>@kayit.KullaniciAdi</strong>
                                    @if (kayit.KullaniciId.HasValue)
                                    {
                                        <small class="d-block text-muted">#@kayit.KullaniciId</small>
                                    }
                                </td>
                                <td>@kayit.Modul</td>
                                <td><span class="badge text-bg-light">@kayit.IslemTuru</span></td>
                                <td>@kayit.Aciklama</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(kayit.EskiDeger) || !string.IsNullOrWhiteSpace(kayit.YeniDeger))
                                    {
                                        <details>
                                            <summary>Görüntüle</summary>
                                            @if (!string.IsNullOrWhiteSpace(kayit.EskiDeger))
                                            {
                                                <strong>Eski değer</strong>
                                                <pre>@kayit.EskiDeger</pre>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(kayit.YeniDeger))
                                            {
                                                <strong>Yeni değer</strong>
                                                <pre>@kayit.YeniDeger</pre>
                                            }
                                            <strong>İstemci</strong>
                                            <div class="small text-muted">IP: @kayit.IpAdresi</div>
                                            <div class="small text-muted text-break">Tarayıcı: @kayit.TarayiciBilgisi</div>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
