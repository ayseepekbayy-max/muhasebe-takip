@page "/Panel"
@model MuhasebeTakip2.App.Pages.PanelModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Firmova ERP</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f3f5f8; color: #172238; font-family: system-ui, sans-serif; }
        main { max-width: 860px; height: 100dvh; margin: auto; display: flex; flex-direction: column; background: white; }
        header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px; border-bottom: 1px solid #e3e7ee; }
        .avatar { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: #e0eee8; font-weight: 600; overflow-wrap: anywhere; text-align: center; }
        .messages { flex: 1; min-height: 0; overflow-y: auto; padding: 20px; background: #f5f7f9; }
        .message { width: fit-content; max-width: 85%; margin: 0 auto 12px 0; padding: 10px 14px; background: white; border: 1px solid #e3e7ee; border-radius: 12px; overflow-wrap: anywhere; }
        .message.own { margin-left: auto; margin-right: 0; background: #e0eee8; border-color: #cfe1d8; }
        .message-actions { margin-bottom: 4px; text-align: right; }
        .message-actions summary { display: inline-block; cursor: pointer; padding: 0 8px; border-radius: 6px; list-style: none; font-size: 20px; }
        .message-actions summary::-webkit-details-marker { display: none; }
        .message-actions summary:focus-visible { outline: 3px solid #5679b9; }
        .delete-message { display: block; margin: 4px 0 0 auto; padding: 6px 10px; font-size: 13px; color: #9a3434; }
        .date-separator { display: table; margin: 8px auto 16px; padding: 5px 12px; border-radius: 10px; background: #e9edf1; color: #68778b; font-size: 12px; text-align: center; }
        .typing-indicator { width: fit-content; margin: 0 auto 12px 0; padding: 7px 12px; border-radius: 12px; background: #eef1f4; color: #68778b; font-size: 12px; }
        .content { white-space: pre-wrap; }
        time { display: block; margin-top: 5px; text-align: right; color: #58677d; font-size: 11px; }
        .composer { display: flex; gap: 12px; padding: 16px; border-top: 1px solid #e3e7ee; align-items: end; }
        .field { flex: 1; min-width: 0; }
        label { display: block; font-size: 14px; margin-bottom: 6px; }
        textarea { width: 100%; resize: none; min-height: 72px; max-height: 180px; padding: 12px; border: 1px solid #c7d0df; border-radius: 8px; font: inherit; }
        button { padding: 10px 16px; border: 1px solid #c7d0df; border-radius: 8px; background: white; color: inherit; font: inherit; cursor: pointer; }
        button:disabled { opacity: .5; cursor: default; }
        button:focus-visible, textarea:focus-visible { outline: 3px solid #5679b9; outline-offset: 2px; }
        [hidden] { display: none !important; }
        .header-left { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
        .last-seen { margin: 6px 0 0; font-size: 11px; color: #68778b; }
        .header-menu { position: relative; }
        .header-menu summary { cursor: pointer; padding: 8px 12px; font-size: 22px; list-style: none; border-radius: 8px; }
        .header-menu summary::-webkit-details-marker { display: none; }
        .header-menu summary:focus-visible { outline: 3px solid #5679b9; }
        .menu-items { position: absolute; top: 100%; left: 0; z-index: 2; width: 170px; padding: 6px; background: white; border: 1px solid #c7d0df; border-radius: 10px; box-shadow: 0 5px 18px #17223820; }
        .menu-items button { width: 100%; border: 0; text-align: left; font-size: 14px; }
        .selection-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 16px; border-bottom: 1px solid #e3e7ee; }
        .message-select { display: flex; align-items: center; gap: 6px; font-size: 12px; }
        .message-select input { width: 18px; height: 18px; }
        dialog { border: 1px solid #c7d0df; border-radius: 14px; padding: 24px; width: min(360px, 90vw); color: inherit; }
        dialog::backdrop { background: #17223866; }
        dialog h2 { margin: 0 0 20px; font-size: 18px; }
        .setting-toggle { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .setting-toggle input { width: 20px; height: 20px; }
        .dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .settings-status { font-size: 13px; color: #9a3434; }
        .status { min-height: 1.4em; margin: 0; padding: 0 16px 8px; color: #9a3434; font-size: 13px; }
        .media-tools { display:flex; gap:6px; flex-wrap:wrap; }
        .media-tools button { padding:10px; min-width:44px; min-height:44px; }
        .message audio { width: min(280px, 60vw); }
        .media-preview { padding: 0 16px 8px; }
        .media-preview audio { max-width:100%; }
        #photo-dialog { width:min(900px,96vw); padding:12px; text-align:center; }
        #photo-dialog img { display:block; max-width:100%; max-height:75dvh; margin:12px auto 0; object-fit:contain; }
        @@media(max-width:540px) { .composer { flex-wrap:wrap; gap:8px; padding:12px; } .composer .field { flex-basis:100%; } header { padding:12px; } .messages { padding:12px; } #send-button { margin-left:auto; } }
    </style>
</head>
<body>
    <main data-media-url="@Url.Page("/Panel", "Media")" data-photo-url="@Url.Page("/Panel", "Photo")" data-audio-url="@Url.Page("/Panel", "Audio")" data-typing-url="@Url.Page("/Panel", "Typing")" data-server-now="@Model.ServerNowUtc.ToString("O")" data-hide-url="@Url.Page("/Panel", "Hide")" data-hide-selected-url="@Url.Page("/Panel", "HideSelected")" data-clear-mine-url="@Url.Page("/Panel", "ClearMine")" data-delete-selected-url="@Url.Page("/Panel", "DeleteSelected")" data-delete-all-url="@Url.Page("/Panel", "DeleteAll")" data-settings-url="@Url.Page("/Panel", "Settings")" data-delete-url="@Url.Page("/Panel", "Delete")" data-person="@Model.CurrentPerson" data-messages-url="@Url.Page("/Panel", "Messages")" data-login-url="@Url.Page("/Login")">
        <header>
            <div class="header-left">
                <div>
                    <div class="avatar">@Model.OtherPersonName</div>
                    <p id="last-seen" class="last-seen" data-at="@Model.OtherLastSeenAtUtc?.ToString("O")" hidden></p>
                </div>
                <details id="header-menu" class="header-menu">
                    <summary aria-label="Sohbet seçenekleri">⋮</summary>
                    <div class="menu-items">
                        <button id="select-messages" type="button">Mesajları seç</button>
                        <button id="delete-all" type="button">Sohbet geçmişini temizle</button>
                        <button id="open-settings" type="button">Ayarlar</button>
                    </div>
                </details>
            </div>
            <form method="post" asp-page="/Panel" asp-page-handler="Logout">
                <button type="submit">Çıkış</button>
            </form>
        </header>
        <div id="selection-bar" class="selection-bar" hidden>
            <span id="selection-count">0 mesaj seçildi</span>
            <button id="hide-selected" type="button" hidden>Kendimden sil</button><button id="delete-selected" type="button" hidden>Herkesten sil</button>
            <button id="cancel-selection" type="button">İptal</button>
        </div>
        <section id="messages" class="messages" aria-label="Mesajlar" tabindex="0">
            @foreach (var message in Model.Messages)
            {
                <article class="message @(message.SenderPerson == Model.CurrentPerson ? "own" : "")" data-id="@message.Id">
                    <details class="message-actions">
                        <summary aria-label="Mesaj seçenekleri">⋮</summary>
                        <button type="button" class="delete-message" data-mode="mine">Kendimden sil</button>
                        @if (message.SenderPerson == Model.CurrentPerson)
                        {
                            <button type="button" class="delete-message" data-mode="everyone">Herkesten sil</button>
                        }
                    </details>
                    <div class="content" data-expired="@(MuhasebeTakip2.App.Pages.PanelModel.PhotoExpired(message) ? "true" : "false")" data-available="@(message.MediaKey != null ? "true" : "false")" data-duration="@message.DurationSeconds" data-kind="@((int)message.Kind)" data-viewed="@(message.ViewedAtUtc.HasValue ? "true" : "false")">@(message.Kind == MuhasebeTakip2.App.Models.PrivateMessageKind.Text ? message.Content : message.Kind == MuhasebeTakip2.App.Models.PrivateMessageKind.Audio ? "Sesli mesaj" : "Tek görüntülemelik fotoğraf")</div>
                    <time datetime="@message.CreatedAtUtc.ToString("O")">@message.CreatedAtUtc.ToString("HH:mm")</time>
                </article>
            }
            <div id="typing-indicator" class="typing-indicator" role="status" hidden>yazıyor...</div>
        </section>
        <form id="send-form" class="composer" method="post" asp-page="/Panel" asp-page-handler="Send">
            <div class="field">
                <label for="entry">Mesaj</label>
                <textarea id="entry" name="content" maxlength="4000" required placeholder="Mesajınızı yazın" autocomplete="off"></textarea>
            </div>
            <div class="media-tools">
                <button id="photo-pick" type="button" aria-label="Fotoğraf gönder" title="Tek görüntülemelik fotoğraf">📷</button>
                <button id="record-audio" type="button" aria-label="Ses kaydı başlat" title="Ses kaydı">🎙</button>
                <input id="photo-file" type="file" accept="image/jpeg,image/png" hidden />
            </div>
            <button id="send-button" type="submit">Gönder</button>
        </form>
        <div id="media-preview" class="media-preview" hidden>
            <span id="media-label" role="status"></span>
            <audio id="audio-preview" controls hidden></audio>
            <button id="media-send" type="button">Gönder</button>
            <button id="media-cancel" type="button">İptal</button>
        </div>
        <p id="send-status" class="status" role="status"></p>
        <p id="poll-status" class="status" role="status"></p>
    </main>
    <dialog id="photo-dialog" aria-label="Tek görüntülemelik fotoğraf">
        <button id="photo-close" type="button">Kapat</button>
        <p>Kapatıldıktan sonra tekrar açılamaz.</p>
        <img id="single-photo" alt="Tek görüntülemelik fotoğraf" draggable="false" />
    </dialog>
    <dialog id="history-dialog" aria-labelledby="history-title">
        <h2 id="history-title">Sohbet geçmişini temizle</h2>
        <button id="clear-mine" type="button">Kendimden sil</button>
        <button id="clear-everyone" type="button">Herkesten sil</button>
        <button id="close-history" type="button">İptal</button>
    </dialog>
    <dialog id="settings-dialog" aria-labelledby="settings-title">
        <h2 id="settings-title">Ayarlar</h2>
        <form id="settings-form" method="post" asp-page="/Panel" asp-page-handler="Settings">
            <label class="setting-toggle">
                <input id="show-last-seen" type="checkbox" role="switch" checked="@Model.ShowLastSeen" />
                Son görülmemi göster
            </label>
            <p id="settings-status" class="settings-status" role="status"></p>
            <div class="dialog-actions">
                <button id="close-settings" type="button">İptal</button>
                <button id="save-settings" type="submit">Kaydet</button>
            </div>
        </form>
    </dialog>
    <script>
        (() => {
            const root = document.querySelector('main');
            const list = document.getElementById('messages');
            const form = document.getElementById('send-form');
            const entry = document.getElementById('entry');
            const button = document.getElementById('send-button');
            const sendStatus = document.getElementById('send-status');
            const pollStatus = document.getElementById('poll-status');
            const person = Number(root.dataset.person);
            const nodes = new Map([...list.querySelectorAll('article[data-id]')].map(node => [Number(node.dataset.id), node]));
            const typingIndicator = document.getElementById('typing-indicator');
            const clock = new Intl.DateTimeFormat('tr-TR', { hour: '2-digit', minute: '2-digit' });
            let sending = false;
            let stopped = false;
            let refreshQueue = Promise.resolve();

            const menu = document.getElementById('header-menu');
            const selectionBar = document.getElementById('selection-bar');
            const selectionCount = document.getElementById('selection-count');
            const hideSelected = document.getElementById('hide-selected');
            const historyDialog = document.getElementById('history-dialog');
            let serverOffset = Date.parse(root.dataset.serverNow) - Date.now();
            const deleteSelected = document.getElementById('delete-selected');
            const deleteAll = document.getElementById('delete-all');
            const settings = document.getElementById('settings-dialog');
            const settingsForm = document.getElementById('settings-form');
            const showLastSeen = document.getElementById('show-last-seen');
            const settingsStatus = document.getElementById('settings-status');
            const saveSettings = document.getElementById('save-settings');
            const lastSeen = document.getElementById('last-seen');
            const selected = new Set();
            let selecting = false;
            let bulkBusy = false;
            let ownShowLastSeen = showLastSeen.checked;

            function closeMenu() { menu.open = false; }
            document.addEventListener('click', event => { if (!menu.contains(event.target)) closeMenu(); });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && menu.open) { closeMenu(); menu.querySelector('summary').focus(); }
            });
            function addSelectionCheckbox(node) {
                const label = document.createElement('label');
                label.className = 'message-select';
                label.hidden = !selecting;
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.setAttribute('aria-label', 'Mesajı seç');
                label.append(checkbox, document.createTextNode('Seç'));
                node.prepend(label);
            }
            function updateSelection() {
                for (const id of selected) if (!nodes.has(id)) selected.delete(id);
                selectionBar.hidden = !selecting;
                selectionCount.textContent = selected.size + ' mesaj seçildi';
                deleteSelected.hidden = selected.size === 0;
                hideSelected.hidden = selected.size === 0;
                hideSelected.disabled = bulkBusy;
                deleteSelected.disabled = bulkBusy || [...selected].some(id => !nodes.get(id)?.classList.contains('own'));
                for (const [id, node] of nodes) {
                    const label = node.querySelector('.message-select');
                    if (label) { label.hidden = !selecting; label.querySelector('input').checked = selected.has(id); }
                }
            }
            function cancelSelection() { selecting = false; selected.clear(); updateSelection(); }
            nodes.forEach(addSelectionCheckbox);
            document.getElementById('select-messages').addEventListener('click', () => {
                closeMenu(); selecting = true; updateSelection();
            });
            document.getElementById('cancel-selection').addEventListener('click', cancelSelection);
            list.addEventListener('change', event => {
                if (!selecting || !event.target.matches('.message-select input')) return;
                const node = event.target.closest('.message');
                const id = Number(node.dataset.id);
                if (event.target.checked) selected.add(id); else selected.delete(id);
                updateSelection();
            });
            function actionBody() {
                const body = new FormData();
                body.append('__RequestVerificationToken', form.querySelector('[name="__RequestVerificationToken"]').value);
                return body;
            }
            let typingQueue = Promise.resolve();
            let typingActive = false;
            let lastTypingSent = -Infinity;
            let typingIdleTimer;
            let typingHeartbeatTimer;
            let peerTypingTimer;
            function sendTyping(active) {
                typingActive = active;
                lastTypingSent = performance.now();
                typingQueue = typingQueue.catch(() => {}).then(async () => {
                    if (stopped) return;
                    const body = actionBody();
                    body.append('typing', String(active));
                    try {
                        await fetch(root.dataset.typingUrl, {
                            method: 'POST', body, credentials: 'same-origin', cache: 'no-store',
                            redirect: 'error', keepalive: true, signal: AbortSignal.timeout(4000)
                        });
                    } catch { /* Best effort: the server expires stale typing automatically. */ }
                });
            }
            function stopTyping() {
                clearTimeout(typingIdleTimer);
                clearTimeout(typingHeartbeatTimer);
                if (typingActive) sendTyping(false);
            }
            entry.addEventListener('input', () => {
                clearTimeout(typingIdleTimer);
                clearTimeout(typingHeartbeatTimer);
                if (!entry.value.trim() || sending || document.hidden) { stopTyping(); return; }
                const delay = Math.max(0, 2000 - (performance.now() - lastTypingSent));
                if (delay === 0) sendTyping(true);
                else typingHeartbeatTimer = setTimeout(() => sendTyping(true), delay);
                typingIdleTimer = setTimeout(stopTyping, 3000);
            });
            form.addEventListener('submit', stopTyping);
            document.querySelector('header form').addEventListener('submit', stopTyping);
            window.addEventListener('pagehide', stopTyping);
            document.addEventListener('visibilitychange', () => { if (document.hidden) stopTyping(); });
            function updateTyping(active, remainingMs) {
                clearTimeout(peerTypingTimer);
                const nearBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 80;
                const wasHidden = typingIndicator.hidden;
                typingIndicator.hidden = !active || remainingMs <= 0;
                if (wasHidden && !typingIndicator.hidden && nearBottom) list.scrollTop = list.scrollHeight;
                if (!typingIndicator.hidden) peerTypingTimer = setTimeout(() => { typingIndicator.hidden = true; }, remainingMs);
            }
            async function postControl(url, body) {
                const response = await fetch(url, { method: 'POST', body, credentials: 'same-origin', cache: 'no-store', redirect: 'error' });
                if (response.status === 401) { stopped = true; location.assign(root.dataset.loginUrl); throw new Error('Oturum sona erdi.'); }
                if (response.status === 403) throw new Error('Bu işlem için yetkiniz yok.');
                if (response.status === 404) throw new Error('Seçilen mesajlardan biri artık mevcut değil.');
                if (!response.ok) throw new Error('İşlem tamamlanamadı. Lütfen tekrar deneyin.');
                return response.json();
            }
            deleteSelected.addEventListener('click', async () => {
                if (bulkBusy || selected.size === 0 || !confirm('Seçilen mesajlar kalıcı olarak silinsin mi?')) return;
                bulkBusy = true; updateSelection(); sendStatus.textContent = '';
                const body = actionBody();
                for (const id of selected) body.append('ids', id);
                try { await postControl(root.dataset.deleteSelectedUrl, body); cancelSelection(); }
                catch (error) { sendStatus.textContent = error.message; }
                finally { bulkBusy = false; await refresh(); updateSelection(); }
            });
            hideSelected.addEventListener('click', async () => {
                if (bulkBusy || selected.size === 0 || !confirm('Seçilen mesajlar yalnızca sizden silinsin mi?')) return;
                bulkBusy = true; updateSelection(); sendStatus.textContent = '';
                const body = actionBody();
                for (const id of selected) body.append('ids', id);
                try { await postControl(root.dataset.hideSelectedUrl, body); cancelSelection(); }
                catch (error) { sendStatus.textContent = error.message; }
                finally { bulkBusy = false; await refresh(); updateSelection(); }
            });
            deleteAll.addEventListener('click', () => { closeMenu(); historyDialog.showModal(); });
            document.getElementById('close-history').addEventListener('click', () => historyDialog.close());
            async function clearHistory(everyone) {
                if (bulkBusy) return;
                if (everyone && !confirm('Tüm sohbet geçmişi iki taraf için kalıcı olarak silinecek. Bu işlem geri alınamaz.')) return;
                bulkBusy = true; sendStatus.textContent = '';
                historyDialog.querySelectorAll('button').forEach(button => button.disabled = true);
                const body = actionBody();
                if (everyone) body.append('confirmed', 'true');
                try {
                    await postControl(everyone ? root.dataset.deleteAllUrl : root.dataset.clearMineUrl, body);
                    cancelSelection(); historyDialog.close();
                } catch (error) { sendStatus.textContent = error.message; }
                finally {
                    bulkBusy = false;
                    historyDialog.querySelectorAll('button').forEach(button => button.disabled = false);
                    await refresh(); updateSelection();
                }
            }
            document.getElementById('clear-mine').addEventListener('click', () => clearHistory(false));
            document.getElementById('clear-everyone').addEventListener('click', () => clearHistory(true));
            document.getElementById('open-settings').addEventListener('click', () => {
                closeMenu(); showLastSeen.checked = ownShowLastSeen; settingsStatus.textContent = ''; settings.showModal();
            });
            document.getElementById('close-settings').addEventListener('click', () => settings.close());
            settings.addEventListener('click', event => {
                const bounds = settings.getBoundingClientRect();
                if (event.target === settings && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) settings.close();
            });
            settingsForm.addEventListener('submit', async event => {
                event.preventDefault();
                if (saveSettings.disabled) return;
                saveSettings.disabled = true; settingsStatus.textContent = '';
                const body = actionBody(); body.append('showLastSeen', String(showLastSeen.checked));
                try {
                    const result = await postControl(root.dataset.settingsUrl, body);
                    ownShowLastSeen = result.showLastSeen;
                    settings.close(); await refresh();
                } catch (error) { settingsStatus.textContent = error.message; }
                finally { saveSettings.disabled = false; }
            });
            function updateLastSeen(value) {
                lastSeen.hidden = !value;
                lastSeen.textContent = '';
                if (!value) return;
                const date = new Date(value);
                const now = new Date(Date.now() + serverOffset);
                if (now - date <= 45000) { lastSeen.textContent = 'Çevrimiçi'; return; }
                const day = date.toDateString() === now.toDateString() ? 'bugün' : date.toLocaleDateString('tr-TR');
                lastSeen.textContent = 'Son görülme ' + day + ' ' + clock.format(date);
            }
            updateLastSeen(lastSeen.dataset.at);
            function createDeleteMenu(isOwn) {
                const menu = document.createElement('details');
                menu.className = 'message-actions';
                const toggle = document.createElement('summary');
                toggle.setAttribute('aria-label', 'Mesaj seçenekleri');
                toggle.textContent = '⋮';
                menu.append(toggle);
                for (const mode of isOwn ? ['mine', 'everyone'] : ['mine']) {
                    const action = document.createElement('button');
                    action.type = 'button';
                    action.className = 'delete-message';
                    action.dataset.mode = mode;
                    action.textContent = mode === 'mine' ? 'Kendimden sil' : 'Herkesten sil';
                    menu.append(action);
                }
                return menu;
            }
            list.addEventListener('click', async event => {
                const action = event.target.closest('.delete-message');
                if (!action || action.disabled || !list.contains(action)) return;
                if (!confirm(action.dataset.mode === 'mine' ? 'Bu mesaj yalnızca sizden silinsin mi?' : 'Bu mesaj herkesten kalıcı olarak silinsin mi?')) return;
                const message = action.closest('.message');
                const body = new FormData();
                body.append('id', message.dataset.id);
                body.append('__RequestVerificationToken', form.querySelector('[name="__RequestVerificationToken"]').value);
                action.disabled = true;
                sendStatus.textContent = '';
                try {
                    const response = await fetch(action.dataset.mode === 'mine' ? root.dataset.hideUrl : root.dataset.deleteUrl, { method: 'POST', body, credentials: 'same-origin', cache: 'no-store', redirect: 'error' });
                    if (response.status === 401) {
                        stopped = true;
                        location.assign(root.dataset.loginUrl);
                        return;
                    }
                    if (response.status === 403) {
                        sendStatus.textContent = 'Bu mesajı silme yetkiniz yok.';
                        return;
                    }
                    if (!response.ok && response.status !== 404) throw new Error('request');
                    await refresh();
                } catch {
                    sendStatus.textContent = 'Mesaj silinemedi. Lütfen tekrar deneyin.';
                } finally {
                    action.disabled = false;
                }
            });

            function setTime(time, value) {
                const date = new Date(value);
                time.dateTime = value;
                time.textContent = clock.format(date);
                time.title = date.toLocaleString('tr-TR');
            }
            const dateSeparators = new Map();
            function localDay(date) {
                return date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate();
            }
            function dateLabel(date, now) {
                if (localDay(date) === localDay(now)) return 'Bugün';
                const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
                if (localDay(date) === localDay(yesterday)) return 'Dün';
                return String(date.getDate()).padStart(2, '0') + '.' +
                    String(date.getMonth() + 1).padStart(2, '0') + '.' + date.getFullYear();
            }
            function arrangeDateGroups(messageNodes) {
                const now = new Date();
                const days = new Set();
                const ordered = [];
                let changed = false;
                for (const node of messageNodes) {
                    const date = new Date(node.querySelector('time').dateTime);
                    const day = localDay(date);
                    if (!days.has(day)) {
                        days.add(day);
                        let separator = dateSeparators.get(day);
                        if (!separator) {
                            separator = document.createElement('div');
                            separator.className = 'date-separator';
                            dateSeparators.set(day, separator);
                        }
                        const label = dateLabel(date, now);
                        if (separator.textContent !== label) { separator.textContent = label; changed = true; }
                        ordered.push(separator);
                    }
                    ordered.push(node);
                }
                for (const [day, separator] of dateSeparators) {
                    if (!days.has(day)) { separator.remove(); dateSeparators.delete(day); changed = true; }
                }
                ordered.push(typingIndicator);
                let position = list.firstElementChild;
                for (const node of ordered) {
                    if (node !== position) { list.insertBefore(node, position); changed = true; }
                    position = node.nextElementSibling;
                }
                return changed;
            }
            list.querySelectorAll('time').forEach(time => setTime(time, time.dateTime));
            arrangeDateGroups([...nodes.values()]);
            list.scrollTop = list.scrollHeight;

            function renderMedia(node, message) {
                const content = node.querySelector('.content');
                const state = message.kind + ':' + message.viewed + ':' + message.expired + ':' + message.available;
                if (content.dataset.mediaState === state) return;
                content.dataset.mediaState = state;
                if (!message.kind) { content.textContent = message.content; return; }
                content.replaceChildren();
                if (message.kind === 1) {
                    const audio = document.createElement('audio');
                    audio.controls = true; audio.preload = 'metadata';
                    audio.setAttribute('controlsList', 'nodownload');
                    audio.src = root.dataset.audioUrl + '&id=' + message.id;
                    audio.addEventListener('error', () => { audio.title = 'Ses yüklenemedi. Oturumunuzu ve bağlantınızı kontrol edin.'; });
                    content.append(audio);
                    const duration = document.createElement("div"); duration.textContent = "Süre: " + (message.durationSeconds || 0) + " sn"; content.append(duration);
                } else if (message.viewed) content.textContent = 'Fotoğraf görüntülendi';
                else if (message.expired) content.textContent = 'Fotoğrafın süresi doldu';
                else if (!message.available) content.textContent = 'Fotoğraf artık mevcut değil';
                else if (message.senderPerson === person) content.textContent = 'Tek görüntülemelik fotoğraf gönderildi';
                else {
                    const open = document.createElement('button');
                    open.type = 'button'; open.textContent = 'Fotoğrafı görüntüle';
                    open.addEventListener('click', () => openPhoto(message.id, open));
                    content.append(open);
                }
            }
            for (const [id, node] of nodes) {
                const content = node.querySelector('.content');
                renderMedia(node, { id, durationSeconds: Number(content.dataset.duration), kind: Number(content.dataset.kind), viewed: content.dataset.viewed === 'true', expired: content.dataset.expired === 'true', available: content.dataset.available === 'true', senderPerson: node.classList.contains('own') ? person : 3-person, content: content.textContent });
            }
            function updateMessages(messages) {
                const nearBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 80;
                const anchor = [...list.querySelectorAll('article[data-id]')].find(node => node.offsetTop + node.offsetHeight > list.scrollTop + list.offsetTop);
                const anchorTop = anchor?.getBoundingClientRect().top;
                const keep = new Set(messages.map(message => message.id));
                let changed = false;
                for (const [id, node] of nodes) {
                    if (!keep.has(id)) { node.remove(); nodes.delete(id); changed = true; }
                }
                for (const message of messages) {
                    let node = nodes.get(message.id);
                    if (!node) {
                        node = document.createElement('article');
                        node.className = message.senderPerson === person ? 'message own' : 'message';
                        node.dataset.id = message.id;
                        const content = document.createElement('div');
                        content.className = 'content';
                        content.textContent = message.content;
                        const time = document.createElement('time');
                        setTime(time, message.createdAtUtc);
                        node.append(createDeleteMenu(message.senderPerson === person));
                        node.append(content, time);
                        addSelectionCheckbox(node);
                        nodes.set(message.id, node);
                        changed = true;
                    }
                }
                for (const message of messages) renderMedia(nodes.get(message.id), message);
                changed = arrangeDateGroups(messages.map(message => nodes.get(message.id))) || changed;
                updateSelection();
                if (changed && nearBottom) list.scrollTop = list.scrollHeight;
                else if (changed && anchor?.isConnected) list.scrollTop += anchor.getBoundingClientRect().top - anchorTop;
            }

            async function loadMessages() {
                if (stopped || document.hidden) return;
                try {
                    const pollStarted = performance.now();
                    const response = await fetch(root.dataset.messagesUrl, { cache: 'no-store', credentials: 'same-origin', redirect: 'error' });
                    if (response.status === 401 || response.status === 403) {
                        stopped = true;
                        location.assign(root.dataset.loginUrl);
                        return;
                    }
                    if (!response.ok) throw new Error('request');
                    const payload = await response.json();
                    serverOffset = Date.parse(payload.serverNowUtc) - Date.now();
                    updateMessages(payload.messages);
                    ownShowLastSeen = payload.presence.showLastSeen;
                    updateLastSeen(payload.presence.otherLastSeenAtUtc);
                    updateTyping(payload.presence.otherTyping, Math.max(0, payload.presence.otherTypingRemainingMs - (performance.now() - pollStarted)));
                    pollStatus.textContent = '';
                } catch {
                    pollStatus.textContent = 'Mesajlar yenilenemedi. Yeniden denenecek.';
                }
            }
            function refresh() {
                refreshQueue = refreshQueue.then(loadMessages, loadMessages);
                return refreshQueue;
            }
            async function poll() {
                await refresh();
                if (!stopped) setTimeout(poll, 2500);
            }
            const photoDialog = document.getElementById('photo-dialog');
            const photoImage = document.getElementById('single-photo');
            let photoUrl, openingPhoto = false;
            function clearPhoto() { photoImage.removeAttribute('src'); if (photoUrl) URL.revokeObjectURL(photoUrl); photoUrl = null; }
            document.getElementById('photo-close').onclick = () => photoDialog.close();
            photoDialog.addEventListener('close', clearPhoto);
            photoImage.addEventListener('load', () => { if (photoUrl) URL.revokeObjectURL(photoUrl); photoUrl = null; });
            photoImage.addEventListener('error', () => { clearPhoto(); photoDialog.close(); sendStatus.textContent = 'Fotoğraf gösterilemedi; tek görüntüleme hakkı kullanıldı.'; });
            photoImage.addEventListener('contextmenu', event => event.preventDefault());
            async function openPhoto(id, control) {
                if (openingPhoto) return;
                openingPhoto = true; control.disabled = true; sendStatus.textContent = '';
                try {
                    const body = actionBody(); body.append('id', id);
                    const response = await fetch(root.dataset.photoUrl, { method:'POST', body, credentials:'same-origin', cache:'no-store', redirect:'error' });
                    if (!response.ok) throw new Error(response.status === 410 ? 'Fotoğraf görüntülendi, süresi doldu veya artık erişilemiyor.' : 'Fotoğraf açılamadı. Oturumunuzu ve bağlantınızı kontrol edin.');
                    clearPhoto(); photoUrl = URL.createObjectURL(await response.blob());
                    if (document.hidden) { clearPhoto(); return; }
                    photoImage.src = photoUrl; photoDialog.showModal();
                } catch(error) { sendStatus.textContent = error.message; }
                finally { openingPhoto = false; control.disabled = false; await refresh(); }
            }
            const photoFile = document.getElementById('photo-file');
            const pickPhoto = document.getElementById('photo-pick');
            const recordButton = document.getElementById('record-audio');
            const mediaPreview = document.getElementById('media-preview');
            const mediaLabel = document.getElementById('media-label');
            const previewAudio = document.getElementById('audio-preview');
            const mediaSend = document.getElementById('media-send');
            const mediaCancel = document.getElementById('media-cancel');
            let pendingDuration, pendingMedia, pendingKind, previewUrl, recorder, stream, recordTimer, recordStart, requestingMic = false, finishingRecording = false, mediaBusy = false, discardRecording = false;
            function clearPending() {
                pendingMedia = null; previewAudio.pause(); previewAudio.removeAttribute('src'); previewAudio.load();
                if (previewUrl) URL.revokeObjectURL(previewUrl);
                previewUrl = null; mediaPreview.hidden = true; photoFile.value = '';
            }
            function stopRecording() {
                clearInterval(recordTimer);
                if (recorder?.state === 'recording') { finishingRecording = true; recorder.stop(); }
                stream?.getTracks().forEach(track => track.stop()); stream = null;
                recordButton.textContent = '🎙'; recordButton.setAttribute('aria-label','Ses kaydı başlat');
            }
            pickPhoto.onclick = () => { if (!mediaBusy && !requestingMic && !finishingRecording && recorder?.state !== 'recording') photoFile.click(); };
            photoFile.onchange = () => {
                const file = photoFile.files[0]; if (!file) return;
                if (file.size > 8*1024*1024 || !['image/jpeg','image/png'].includes(file.type)) { sendStatus.textContent = 'En fazla 8 MB JPEG veya PNG fotoğraf seçin.'; photoFile.value = ''; return; }
                clearPending(); pendingMedia = file; pendingKind = 'photo';
                mediaLabel.textContent = 'Tek görüntülemelik fotoğraf hazır.'; previewAudio.hidden = true; mediaPreview.hidden = false; mediaSend.disabled = false;
            };
            mediaCancel.onclick = () => { discardRecording = true; stopRecording(); clearPending(); };
            recordButton.onclick = async () => {
                if (mediaBusy || requestingMic || finishingRecording) return;
                if (recorder?.state === 'recording') { stopRecording(); return; }
                if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) { sendStatus.textContent = 'Bu tarayıcıda ses kaydı desteklenmiyor. HTTPS üzerinden güncel bir tarayıcı kullanın.'; return; }
                requestingMic = true; recordButton.disabled = true; clearPending(); sendStatus.textContent = '';
                try {
                    stream = await navigator.mediaDevices.getUserMedia({audio:true});
                    if (document.hidden) { stream.getTracks().forEach(t => t.stop()); stream = null; return; }
                    const type = ['audio/webm;codecs=opus','audio/mp4','audio/ogg;codecs=opus'].find(t => MediaRecorder.isTypeSupported(t));
                    if (!type) throw new Error('unsupported');
                    recorder = new MediaRecorder(stream, {mimeType:type});
                    const chunks = []; let size = 0; discardRecording = false;
                    recorder.ondataavailable = event => { if (event.data.size) { chunks.push(event.data); size += event.data.size; if (size > 16*1024*1024) { discardRecording = true; stopRecording(); sendStatus.textContent = 'Ses kaydı 16 MB sınırını aştı.'; } } };
                    recorder.onerror = () => { discardRecording = true; stopRecording(); clearPending(); sendStatus.textContent = 'Ses kaydı tamamlanamadı.'; };
                    recorder.onstop = () => {
                        finishingRecording = false;
                        if (discardRecording || size === 0) { clearPending(); return; }
                        pendingMedia = new Blob(chunks,{type:recorder.mimeType}); pendingKind = 'audio'; pendingDuration = Math.max(1, Math.min(305, Math.round((Date.now()-recordStart)/1000)));
                        previewUrl = URL.createObjectURL(pendingMedia); previewAudio.src = previewUrl; previewAudio.hidden = false;
                        mediaLabel.textContent = 'Ses kaydı hazır (' + Math.round((Date.now()-recordStart)/1000) + ' sn).'; mediaPreview.hidden = false; mediaSend.disabled = false;
                    };
                    recorder.start(1000); recordStart = Date.now(); mediaPreview.hidden = false; previewAudio.hidden = true; mediaSend.disabled = true;
                    recordButton.textContent = '⏹'; recordButton.setAttribute('aria-label','Ses kaydını durdur');
                    mediaLabel.textContent = '● Kayıt devam ediyor: 0 sn';
                    recordTimer = setInterval(() => { const seconds = Math.floor((Date.now()-recordStart)/1000); mediaLabel.textContent = '● Kayıt devam ediyor: ' + seconds + ' sn'; if (seconds >= 300) stopRecording(); }, 1000);
                } catch(error) {
                    stopRecording(); sendStatus.textContent = error.name === 'NotAllowedError' ? 'Mikrofon izni verilmedi. Yazılı mesaj göndermeye devam edebilirsiniz.' : 'Mikrofona erişilemedi veya kayıt biçimi desteklenmiyor.';
                } finally { requestingMic = false; recordButton.disabled = false; }
            };
            mediaSend.onclick = async () => {
                if (!pendingMedia || mediaBusy) return;
                mediaBusy = true; mediaSend.disabled = mediaCancel.disabled = pickPhoto.disabled = recordButton.disabled = true;
                sendStatus.textContent = '';
                try {
                    const body = actionBody(); body.append('kind',pendingKind); if (pendingKind === 'audio') body.append('durationSeconds',pendingDuration); body.append('file',pendingMedia,'media');
                    const response = await fetch(root.dataset.mediaUrl,{method:'POST',body,credentials:'same-origin',cache:'no-store',redirect:'error'});
                    if (!response.ok) { const result = await response.json().catch(() => ({})); throw new Error(result.error || 'Medya gönderilemedi. Oturumunuzu ve dosya boyutunu kontrol edin.'); }
                    clearPending(); await refresh();
                } catch(error) { sendStatus.textContent = error.message; }
                finally { mediaBusy = false; mediaSend.disabled = mediaCancel.disabled = pickPhoto.disabled = recordButton.disabled = false; }
            };
            function releaseMedia() { discardRecording = true; stopRecording(); clearPending(); if (photoDialog.open) photoDialog.close(); clearPhoto(); }
            window.addEventListener('pagehide',releaseMedia);
            document.addEventListener('visibilitychange',() => { if (document.hidden) { if (photoDialog.open) photoDialog.close(); if (recorder?.state === 'recording') stopRecording(); } });

            function updateButton() { button.disabled = sending || !entry.value.trim(); }
            entry.addEventListener('input', updateButton);
            entry.addEventListener('keydown', event => {
                if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
                    event.preventDefault();
                    if (!sending && entry.value.trim()) form.requestSubmit();
                }
            });
            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (sending || !entry.value.trim()) return;
                const body = new FormData(form);
                sending = true;
                entry.disabled = true;
                updateButton();
                sendStatus.textContent = '';
                try {
                    const response = await fetch(form.action, { method: 'POST', body, credentials: 'same-origin', cache: 'no-store', redirect: 'error' });
                    if (response.status === 401 || response.status === 403) {
                        stopped = true;
                        location.assign(root.dataset.loginUrl);
                        return;
                    }
                    if (!response.ok) throw new Error('request');
                    entry.value = '';
                    await refresh();
                } catch {
                    sendStatus.textContent = 'Gönderim doğrulanamadı. Tekrar denemeden önce mesaj listesini kontrol edin.';
                } finally {
                    sending = false;
                    entry.disabled = false;
                    updateButton();
                    entry.focus();
                }
            });
            updateButton();
            poll();
        })();
    </script>
</body>
</html>