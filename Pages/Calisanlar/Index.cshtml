@page "/Calisanlar"
@model MuhasebeTakip2.App.Pages.Calisanlar.IndexModel
@{
    ViewData["Title"] = "Çalışanlar";
}

<div class="app-page calisan-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Personel Yönetimi</span>
            <h1>Çalışanlar</h1>
            <p>Çalışan kartlarını, maaş-avans durumunu ve bu ayki puantaj özetini tek ekrandan yönetin.</p>
        </div>

        <div class="app-page-actions">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#yeniCalisanModal">
                Yeni Çalışan
            </button>
            <a class="btn btn-outline-success"
               asp-page-handler="DisaAktar"
               asp-route-AdSoyadAra="@Model.AdSoyadAra"
               asp-route-TelefonAra="@Model.TelefonAra"
               asp-route-DurumFiltre="@Model.DurumFiltre"
               asp-route-TarihBaslangic="@Model.TarihBaslangic"
               asp-route-TarihBitis="@Model.TarihBitis">Excel İndir</a>
            <a class="btn btn-outline-dark" href="/Calisanlar/Arsiv">Çalışan Arşivi</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }
    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Mesaj))
    {
        <div class="app-alert app-alert-success">@Model.Mesaj</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="calisan-metric-grid">
        <article class="metric-card">
            <span>Toplam Çalışan</span>
            <strong>@Model.ToplamCalisan</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Aktif Çalışan</span>
            <strong>@Model.AktifCalisan</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Bu Ay Maaş</span>
            <strong>@Model.BuAyMaas.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-warning">
            <span>Bu Ay Avans</span>
            <strong>@Model.BuAyAvans.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Bekleyen Maaş</span>
            <strong>@Model.BekleyenMaas.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Bu Ay Devamsızlık</span>
            <strong>@Model.BuAyDevamsizlik</strong>
        </article>
    </section>

    <section class="calisan-filter-panel">
        <div class="panel-title-row">
            <div>
                <h2>Çalışan Ara ve Filtrele</h2>
                <p>Ad soyad, telefon, durum ve işe giriş tarihine göre listeyi daraltın.</p>
            </div>
            <div class="filter-summary">
                <strong>@Model.Liste.Count</strong>
                <span>çalışan</span>
            </div>
        </div>

        <form method="get" class="app-form-grid calisan-filter-grid">
            <div class="form-field">
                <label asp-for="AdSoyadAra">Ad Soyad</label>
                <input asp-for="AdSoyadAra" type="search" placeholder="Çalışan adı" />
            </div>
            <div class="form-field">
                <label asp-for="TelefonAra">Telefon</label>
                <input asp-for="TelefonAra" type="search" placeholder="Telefon ara" />
            </div>
            <div class="form-field">
                <label asp-for="DurumFiltre">Durum</label>
                <select asp-for="DurumFiltre">
                    <option value="">Tümü</option>
                    <option value="Aktif">Aktif</option>
                    <option value="Ayrildi">Ayrıldı</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="TarihBaslangic">Tarih Başlangıç</label>
                <input asp-for="TarihBaslangic" type="date" />
            </div>
            <div class="form-field">
                <label asp-for="TarihBitis">Tarih Bitiş</label>
                <input asp-for="TarihBitis" type="date" />
            </div>
            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a class="btn btn-outline-dark" href="/Calisanlar">Temizle</a>
            </div>
        </form>
    </section>

    <section class="dashboard-panel calisan-list-section">
        <div class="panel-title-row">
            <div>
                <h2>Çalışan Listesi</h2>
                <p>Maaş, son avans, son maaş ve durum bilgilerini hızlıca karşılaştırın.</p>
            </div>
        </div>

        @if (Model.Liste.Count == 0)
        {
            <div class="empty-state">Filtreye uygun çalışan bulunamadı.</div>
        }
        else
        {
            <div class="calisan-card-list">
                @foreach (var c in Model.Liste)
                {
                    <article class="calisan-list-card @(c.AktifMi ? "" : "calisan-list-card-passive")">
                        <div class="calisan-card-identity">
                            <div class="calisan-avatar" aria-hidden="true">@c.BasHarf</div>
                            <div>
                                <span class="status-pill @(c.AktifMi ? "status-pill-income" : "status-pill-expense")">
                                    @(c.AktifMi ? "Aktif" : "Ayrıldı")
                                </span>
                                <h3>@c.AdSoyad</h3>
                                <p>@(string.IsNullOrWhiteSpace(c.Telefon) ? "Telefon belirtilmemiş" : c.Telefon)</p>
                            </div>
                        </div>

                        <div class="calisan-card-data">
                            <div>
                                <span>Maaş</span>
                                <strong>@c.Maas.ToString("N2") ₺</strong>
                            </div>
                            <div>
                                <span>Son Avans</span>
                                <strong class="amount-expense">@c.SonAvans.ToString("N2") ₺</strong>
                                <small>@(c.SonAvansTarihi.HasValue ? c.SonAvansTarihi.Value.ToString("dd.MM.yyyy") : "-")</small>
                            </div>
                            <div>
                                <span>Son Maaş</span>
                                <strong class="amount-income">@c.SonMaas.ToString("N2") ₺</strong>
                                <small>@(c.SonMaasTarihi.HasValue ? c.SonMaasTarihi.Value.ToString("dd.MM.yyyy") : "-")</small>
                            </div>
                            <div>
                                <span>Bu Ay</span>
                                <strong>@c.BuAyMaas.ToString("N2") ₺</strong>
                                <small>Avans: @c.BuAyAvans.ToString("N2") ₺</small>
                            </div>
                            <div>
                                <span>İşe Giriş</span>
                                <strong>@c.IseGirisTarihi.ToString("dd.MM.yyyy")</strong>
                                @if (!c.AktifMi && c.AyrilisTarihi.HasValue)
                                {
                                    <small>Ayrılış: @c.AyrilisTarihi.Value.ToString("dd.MM.yyyy")</small>
                                }
                            </div>
                        </div>

                        <div class="calisan-card-actions">
                            <a class="btn btn-primary btn-sm" href="/Calisanlar/Detay/@c.Id">Detay</a>
                            <a class="btn btn-outline-success btn-sm" href="/Calisanlar/Puantaj/@c.Id">Puantaj</a>
                            <a class="btn btn-outline-primary btn-sm"
                               asp-page="/Calisanlar/Index"
                               asp-route-DuzenleId="@c.Id"
                               asp-route-AdSoyadAra="@Model.AdSoyadAra"
                               asp-route-TelefonAra="@Model.TelefonAra"
                               asp-route-DurumFiltre="@Model.DurumFiltre"
                               asp-route-TarihBaslangic="@Model.TarihBaslangic"
                               asp-route-TarihBitis="@Model.TarihBitis">Düzenle</a>

                            @if (c.AktifMi)
                            {
                                <form method="post" asp-page-handler="Arsivle" class="inline-form"
                                      onsubmit="return confirm('Bu çalışan ayrıldı olarak işaretlenecek. Devam edilsin mi?');">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" formnovalidate class="btn btn-outline-secondary btn-sm">Ayrıldı Yap</button>
                                </form>
                            }

                            <form method="post" asp-page-handler="Sil" class="inline-form"
                                  onsubmit="return confirm('Bu çalışan kalıcı olarak silinecek. Bağlı maaş, avans ve puantaj kayıtları da silinir. Devam edilsin mi?');">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<div class="modal fade" id="yeniCalisanModal" tabindex="-1" aria-labelledby="yeniCalisanModalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cari-modal-content">
            <div class="modal-header">
                <div>
                    <span class="app-page-eyebrow">Yeni Kayıt</span>
                    <h2 class="modal-title" id="yeniCalisanModalBaslik">Yeni Çalışan</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form method="post" asp-page-handler="Ekle">
                <div class="modal-body">
                    <div class="cari-modal-form">
                        <div class="form-field">
                            <label asp-for="YeniCalisan.AdSoyad">Ad Soyad</label>
                            <input asp-for="YeniCalisan.AdSoyad" autofocus />
                        </div>
                        <div class="form-field">
                            <label asp-for="YeniCalisan.Telefon">Telefon</label>
                            <input asp-for="YeniCalisan.Telefon" />
                        </div>
                        <div class="form-field">
                            <label asp-for="YeniCalisan.Maas">Maaş</label>
                            <input asp-for="YeniCalisan.Maas" type="number" min="0" step="0.01" />
                        </div>
                        <div class="form-field">
                            <label asp-for="YeniCalisan.IseGirisTarihi">İşe Giriş Tarihi</label>
                            <input asp-for="YeniCalisan.IseGirisTarihi" type="date" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Çalışan Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="duzenleCalisanModal" tabindex="-1" aria-labelledby="duzenleCalisanModalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cari-modal-content">
            <div class="modal-header">
                <div>
                    <span class="app-page-eyebrow">Kayıt Güncelle</span>
                    <h2 class="modal-title" id="duzenleCalisanModalBaslik">Çalışan Düzenle</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form method="post" asp-page-handler="Duzenle">
                <input type="hidden" asp-for="DuzenlenenCalisan.Id" />
                <div class="modal-body">
                    <div class="cari-modal-form">
                        <div class="form-field">
                            <label asp-for="DuzenlenenCalisan.AdSoyad">Ad Soyad</label>
                            <input asp-for="DuzenlenenCalisan.AdSoyad" />
                        </div>
                        <div class="form-field">
                            <label asp-for="DuzenlenenCalisan.Telefon">Telefon</label>
                            <input asp-for="DuzenlenenCalisan.Telefon" />
                        </div>
                        <div class="form-field">
                            <label asp-for="DuzenlenenCalisan.Maas">Maaş</label>
                            <input asp-for="DuzenlenenCalisan.Maas" type="number" min="0" step="0.01" />
                        </div>
                        <div class="form-field">
                            <label asp-for="DuzenlenenCalisan.IseGirisTarihi">İşe Giriş Tarihi</label>
                            <input asp-for="DuzenlenenCalisan.IseGirisTarihi" type="date" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-dark" href="/Calisanlar">Vazgeç</a>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.YeniCalisanModalAcik)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('yeniCalisanModal')).show();
            });
        </script>
    }
    @if (Model.DuzenlemeModalAcik)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('duzenleCalisanModal')).show();
            });
        </script>
    }
}
