@page
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.IndexModel
@{
    ViewData["Title"] = "Kontrol Paneli";
}

<div class="dashboard-page dashboard-responsive">
    <section class="dashboard-hero-panel">
        <div>
            <span class="dashboard-eyebrow">Firmova ERP</span>
            <h1>Kontrol Paneli</h1>
            <p>Finans hareketlerinizi, kasa durumunuzu ve işletme özetinizi tek ekrandan takip edin.</p>
        </div>

        <div class="dashboard-hero-actions">
            <a class="dashboard-action dashboard-action-primary" href="/Kasa/HareketEkle">Kasa Hareketi Ekle</a>
            <a class="dashboard-action" href="/Raporlar">Raporları Aç</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }

    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SayfaHata))
    {
        <div class="app-alert app-alert-danger">@Model.SayfaHata</div>
    }

    <section class="dashboard-metric-grid">
        <article class="metric-card metric-card-positive">
            <span>Bugünkü Kasa Girişi</span>
            <strong>@Model.BugunGiris.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-negative">
            <span>Bugünkü Kasa Çıkışı</span>
            <strong>@Model.BugunCikis.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-positive">
            <span>Bu Ay Gelir</span>
            <strong>@Model.BuAyGiris.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-negative">
            <span>Bu Ay Gider</span>
            <strong>@Model.BuAyCikis.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-warning">
            <span>Bekleyen Faturalar</span>
            <strong>@Model.BekleyenFaturaToplami.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-positive">
            <span>Ödenmiş Faturalar</span>
            <strong>@Model.OdenmisFaturaToplami.ToString("N2") TL</strong>
        </article>

        <article class="metric-card metric-card-negative">
            <span>Kritik Stok</span>
            <strong>@Model.KritikStokSayisi</strong>
        </article>

        <article class="metric-card">
            <span>Aktif Müşteri</span>
            <strong>@Model.MusteriSayisi</strong>
        </article>

        <article class="metric-card">
            <span>Aktif Çalışan</span>
            <strong>@Model.CalisanSayisi</strong>
        </article>
    </section>

    <section class="dashboard-content-grid">
        <div class="dashboard-stack">
            <section class="dashboard-panel notification-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Bildirim / Hatırlatma</h2>
                        <p>Vade, çek ve stok uyarıları</p>
                    </div>
                </div>

                @if (Model.Bildirimler.Count == 0)
                {
                    <div class="empty-state">Şu an önemli bir hatırlatma yok.</div>
                }
                else
                {
                    <div class="notification-list">
                        @foreach (var bildirim in Model.Bildirimler)
                        {
                            <a class="notification-item @(bildirim.Kritik ? "notification-critical" : "")" href="@bildirim.Url">
                                <span>@bildirim.Tur</span>
                                <strong>@bildirim.Baslik</strong>
                                <small>@bildirim.Aciklama</small>
                            </a>
                        }
                    </div>
                }
            </section>
            <section class="dashboard-panel balance-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Kasa Özeti</h2>
                        <p>Genel kasa bakiyesi ve işletme sayıları</p>
                    </div>
                </div>

                <div class="balance-card">
                    <span>Güncel Kasa Bakiye</span>
                    <strong class="dashboard-card-balance">@Model.KasaBakiye.ToString("N2") TL</strong>
                </div>

                <div class="summary-grid">
                    <article>
                        <span>Cari Sayısı</span>
                        <strong>@Model.CariSayisi</strong>
                    </article>

                    <article>
                        <span>Çalışan Sayısı</span>
                        <strong>@Model.CalisanSayisi</strong>
                    </article>
                </div>
            </section>

            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Son İşlem Geçmişi</h2>
                        <p>Firmada yapılan son 10 işlem</p>
                    </div>
                    <a class="panel-link" href="/IslemGecmisi">Tümünü Gör</a>
                </div>

                @if (Model.SonIslemler.Count == 0)
                {
                    <div class="empty-state">Henüz işlem geçmişi yok.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Kullanıcı</th>
                                    <th>Modül</th>
                                    <th>İşlem</th>
                                    <th>Açıklama</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var islem in Model.SonIslemler)
                                {
                                    <tr>
                                        <td class="text-nowrap">@islem.Tarih.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@islem.KullaniciAdi</td>
                                        <td><span class="status-pill status-pill-neutral">@islem.Modul</span></td>
                                        <td>@islem.IslemTuru</td>
                                        <td>@islem.Aciklama</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="dashboard-panel">
                <div class="panel-title-row">
                    <div>
                        <h2>Son Kasa Hareketleri</h2>
                        <p>En son kaydedilen 10 kasa hareketi</p>
                    </div>
                    <a class="panel-link" href="/Kasa/Hareketler">Tümünü Gör</a>
                </div>

                @if (Model.SonHareketler.Count == 0)
                {
                    <div class="empty-state">Henüz kasa hareketi yok.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Tip</th>
                                    <th>Tutar</th>
                                    <th>Cari</th>
                                    <th>Açıklama</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.SonHareketler)
                                {
                                    var girisMi = h.Tip == HareketTipi.Giris;
                                    <tr>
                                        <td>@h.Tarih.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <span class="status-pill @(girisMi ? "status-pill-income" : "status-pill-expense")">
                                                @(girisMi ? "Giriş" : "Çıkış")
                                            </span>
                                        </td>
                                        <td class="amount-cell @(girisMi ? "amount-income" : "amount-expense")">@h.Tutar.ToString("N2")</td>
                                        <td>@(h.CariKart?.Unvan ?? "-")</td>
                                        <td>@h.Aciklama</td>
                                        <td>
                                            <form method="post" asp-page-handler="Sil" class="inline-form"
                                                  onsubmit="return confirm('Bu kasa hareketi silinecek. Yine de silmek istiyor musunuz?');">
                                                <input type="hidden" name="id" value="@h.Id" />
                                                <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <aside class="dashboard-panel quick-actions-panel">
            <div class="panel-title-row">
                <div>
                    <h2>Hızlı İşlemler</h2>
                    <p>Sık kullanılan ekranlara geçiş</p>
                </div>
            </div>

            <div class="quick-action-list">
                <a class="quick-action primary" href="/Kasa/HareketEkle">
                    <span>+</span>
                    <strong>Kasa Hareketi Ekle</strong>
                </a>

                <a class="quick-action" href="/CariKartlar">
                    <span>C</span>
                    <strong>Cari Kartlar</strong>
                </a>

                <a class="quick-action" href="/Calisanlar">
                    <span>Ç</span>
                    <strong>Çalışanlar</strong>
                </a>

                <a class="quick-action" href="/Musteriler">
                    <span>M</span>
                    <strong>Müşteriler</strong>
                </a>

                <a class="quick-action" href="/Raporlar">
                    <span>R</span>
                    <strong>Raporlar</strong>
                </a>
            </div>
        </aside>
    </section>
</div>

<div class="firmova-float" id="firmovaFloat">
    <button type="button" class="firmova-float-btn" onclick="firmovaToggle()">
        <span class="firmova-pulse"></span>
        <strong>Nova</strong>
    </button>

    <div class="firmova-mini-panel" id="firmovaPanel">
        <div class="firmova-mini-header">
            <div>
                <strong>Nova Asistan</strong>
                <small id="firmovaMiniDurum">Hazır</small>
            </div>

            <button type="button" onclick="firmovaToggle()">×</button>
        </div>

        <div class="firmova-mini-chat" id="firmovaMiniChat">
            <div class="firmova-mini-msg bot">Merhaba, nasıl yardımcı olayım?</div>
        </div>

        <form class="firmova-mini-form" id="firmovaMiniForm" onsubmit="firmovaMiniSor(event)">
            @Html.AntiForgeryToken()

            <input id="firmovaMiniInput"
                   type="text"
                   placeholder="Örn: kasa bakiyesi?"
                   autocomplete="off" />

            <button type="submit">Sor</button>
        </form>

        <a class="firmova-full-link" href="/AiAsistan">Tam ekran AI Asistanı aç</a>
    </div>
</div>

@section Scripts {
    <script>
        function firmovaToggle() {
            const panel = document.getElementById("firmovaPanel");

            if (panel) {
                panel.classList.toggle("open");
            }
        }

        function firmovaMiniMesajEkle(tip, metin) {
            const chat = document.getElementById("firmovaMiniChat");
            if (!chat) return;

            const div = document.createElement("div");
            div.className = "firmova-mini-msg " + tip;
            div.innerText = metin;

            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
        }

        async function firmovaMiniSor(e) {
            e.preventDefault();

            const form = document.getElementById("firmovaMiniForm");
            const input = document.getElementById("firmovaMiniInput");
            const durum = document.getElementById("firmovaMiniDurum");

            if (!form || !input || !input.value.trim()) return;

            const soru = input.value.trim();
            input.value = "";

            firmovaMiniMesajEkle("user", soru);

            if (durum) {
                durum.innerText = "Düşünüyor...";
            }

            try {
                const fd = new FormData(form);
                fd.set("Soru", soru);

                const response = await fetch("/AiAsistan?handler=Ajax", {
                    method: "POST",
                    body: fd
                });

                if (!response.ok) {
                    throw new Error("Sunucu cevap vermedi.");
                }

                const data = await response.json();
                const cevap = data.cevap || "Cevap alınamadı.";

                firmovaMiniMesajEkle("bot", cevap);

                if (durum) {
                    durum.innerText = "Hazır";
                }
            }
            catch {
                firmovaMiniMesajEkle("bot", "Bağlantı hatası oluştu.");

                if (durum) {
                    durum.innerText = "Hata";
                }
            }
        }
    </script>
}
