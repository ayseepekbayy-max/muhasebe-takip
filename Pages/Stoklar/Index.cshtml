@page
@model MuhasebeTakip2.App.Pages.Stoklar.IndexModel
@{
    ViewData["Title"] = "Stok";
}

<div class="app-page stok-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Stok Yönetimi</span>
            <h1>Stoklar</h1>
            <p>Ürün miktarlarını, son alış fiyatlarını ve kritik seviyeleri tek ekrandan yönetin.</p>
        </div>

        <div class="app-page-actions">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#yeniUrunModal">
                Yeni Ürün
            </button>
            <a class="btn btn-outline-success"
               asp-page-handler="DisaAktar"
               asp-route-UrunAra="@Model.UrunAra"
               asp-route-KritikFiltre="@Model.KritikFiltre"
               asp-route-BirimFiltre="@Model.BirimFiltre">Excel İndir</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }
    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="stok-metric-grid">
        <article class="metric-card">
            <span>Toplam Ürün</span>
            <strong>@Model.ToplamUrunSayisi</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Kritik Stok</span>
            <strong>@Model.KritikStokSayisi</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Toplam Stok Değeri</span>
            <strong>@Model.ToplamStokDegeri.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Bugünkü Giriş</span>
            <strong>@Model.BugunkuGirisMiktari.ToString("N2")</strong>
        </article>
        <article class="metric-card metric-card-warning">
            <span>Bugünkü Çıkış</span>
            <strong>@Model.BugunkuCikisMiktari.ToString("N2")</strong>
        </article>
    </section>

    <section class="stok-filter-panel">
        <div class="panel-title-row">
            <div>
                <h2>Ürün Ara ve Filtrele</h2>
                <p>Ürün adı, kod, kritik durum veya birime göre listeyi daraltın.</p>
            </div>
            <div class="filter-summary">
                <strong>@Model.Liste.Count</strong>
                <span>ürün</span>
            </div>
        </div>

        <form method="get" class="app-form-grid stok-filter-grid">
            <div class="form-field">
                <label asp-for="UrunAra">Ürün Adı / Kod</label>
                <input asp-for="UrunAra" type="search" placeholder="Ürün adı veya kod" />
            </div>
            <div class="form-field">
                <label asp-for="BirimFiltre">Birim</label>
                <select asp-for="BirimFiltre">
                    <option value="">Tümü</option>
                    @foreach (var birim in Model.BirimSecenekleri)
                    {
                        <option value="@birim">@birim</option>
                    }
                </select>
            </div>
            <div class="form-field stok-critical-field">
                <label for="KritikFiltre">Stok Durumu</label>
                <label class="stok-check-control">
                    <input asp-for="KritikFiltre" />
                    <span>Yalnızca kritik stoklar</span>
                </label>
            </div>
            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a class="btn btn-outline-dark" asp-page="/Stoklar/Index">Temizle</a>
            </div>
        </form>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row">
            <div>
                <h2>Ürün Listesi</h2>
                <p>Stok, fiyat ve değer bilgilerini karşılaştırın.</p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="modern-table stock-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Kod</th>
                        <th>Birim</th>
                        <th>Mevcut Stok</th>
                        <th>Minimum</th>
                        <th>Son Alış</th>
                        <th>KDV Dahil</th>
                        <th>Stok Değeri</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Liste.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-row">Filtreye uygun ürün bulunamadı.</td></tr>
                    }
                    else
                    {
                        @foreach (var urun in Model.Liste)
                        {
                            <tr class="@(urun.KritikMi ? "stock-critical-row" : "")">
                                <td>
                                    <div class="stock-product-cell">
                                        <strong>@urun.Ad</strong>
                                        @if (urun.KritikMi)
                                        {
                                            <span class="status-pill status-pill-expense">Kritik</span>
                                        }
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(urun.Kod) ? "-" : urun.Kod)</td>
                                <td>@urun.Birim</td>
                                <td>
                                    <span class="status-pill @(urun.KritikMi ? "status-pill-expense" : "status-pill-income")">
                                        @urun.MevcutStok.ToString("N2")
                                    </span>
                                </td>
                                <td>@urun.MinStokSeviyesi.ToString("N2")</td>
                                <td class="amount-cell">@urun.SonBirimFiyat.ToString("N2") ₺</td>
                                <td class="amount-cell">@urun.SonKdvDahilBirimFiyat.ToString("N2") ₺</td>
                                <td class="amount-cell">@urun.StokDegeri.ToString("N2") ₺</td>
                                <td class="table-actions-cell">
                                    <a class="btn btn-primary btn-sm" asp-page="/Stoklar/Detay/Index" asp-route-id="@urun.Id">Detay</a>
                                    <form method="post" asp-page-handler="Sil" class="inline-form"
                                          onsubmit="return confirm('Ürün ve tüm stok hareketleri silinsin mi?');">
                                        <input type="hidden" name="id" value="@urun.Id" />
                                        <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade" id="yeniUrunModal" tabindex="-1" aria-labelledby="yeniUrunModalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cari-modal-content">
            <div class="modal-header">
                <div>
                    <span class="app-page-eyebrow">Yeni Kayıt</span>
                    <h2 class="modal-title" id="yeniUrunModalBaslik">Yeni Ürün Kartı</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form method="post" asp-page-handler="Ekle">
                <div class="modal-body">
                    <div class="cari-modal-form">
                        <div class="form-field">
                            <label asp-for="Yeni.Ad">Ürün Adı</label>
                            <input asp-for="Yeni.Ad" autofocus />
                        </div>
                        <div class="form-field">
                            <label asp-for="Yeni.Kod">Kod</label>
                            <input asp-for="Yeni.Kod" />
                        </div>
                        <div class="form-field">
                            <label asp-for="Yeni.Birim">Birim</label>
                            <input asp-for="Yeni.Birim" placeholder="Adet, m², metre..." />
                        </div>
                        <div class="form-field">
                            <label asp-for="Yeni.MinStokSeviyesi">Minimum Stok</label>
                            <input asp-for="Yeni.MinStokSeviyesi" type="number" min="0" step="0.01" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Ürün Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.YeniUrunModalAcik)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('yeniUrunModal')).show();
            });
        </script>
    }
}
