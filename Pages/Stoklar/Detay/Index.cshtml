@page "{id:int}"
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.Stoklar.Detay.IndexModel
@{
    ViewData["Title"] = "Stok Detay";
    var kritikMi = Model.Urun != null && Model.Stok < Model.Urun.MinStokSeviyesi;
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Stok Detayı</span>
            <h1>@Model.Urun?.Ad</h1>
            <p>
                Kod: @(string.IsNullOrWhiteSpace(Model.Urun?.Kod) ? "-" : Model.Urun.Kod)
                · Birim: @Model.Urun?.Birim
            </p>
        </div>
        <div class="app-page-actions">
            @if (kritikMi)
            {
                <span class="status-pill status-pill-expense">Kritik Stok</span>
            }
            <a class="btn btn-outline-dark" asp-page="/Stoklar/Index">Stok Listesi</a>
        </div>
    </section>

    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="stok-detail-metrics">
        <article class="metric-card @(kritikMi ? "metric-card-negative" : "metric-card-positive")">
            <span>Mevcut Stok</span>
            <strong>@Model.Stok.ToString("N2") @Model.Urun?.Birim</strong>
        </article>
        <article class="metric-card metric-card-positive">
            <span>Toplam Giriş</span>
            <strong>@Model.ToplamGiris.ToString("N2")</strong>
        </article>
        <article class="metric-card metric-card-warning">
            <span>Toplam Çıkış</span>
            <strong>@Model.ToplamCikis.ToString("N2")</strong>
        </article>
        <article class="metric-card">
            <span>Son Giriş Fiyatı</span>
            <strong>@Model.SonGirisFiyati.ToString("N2") ₺</strong>
        </article>
        <article class="metric-card">
            <span>Stok Değeri</span>
            <strong>@Model.StokDegeri.ToString("N2") ₺</strong>
        </article>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row">
            <div>
                <h2>Kritik Stok Ayarı</h2>
                <p>Mevcut stok bu seviyenin altına düştüğünde ürün kritik görünür.</p>
            </div>
        </div>
        <form method="post" asp-page-handler="MinStokGuncelle" class="stok-threshold-form">
            <div class="form-field">
                <label asp-for="MinStokSeviyesi">Minimum Stok Seviyesi</label>
                <input asp-for="MinStokSeviyesi" type="number" min="0" step="0.01" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Eşiği Güncelle</button>
        </form>
    </section>

    <section class="two-column-grid">
        <div class="app-form-panel">
            <div class="panel-title-row">
                <div><h2>Stok Girişi</h2><p>Alış fiyatı ve KDV bilgisiyle giriş kaydedin.</p></div>
            </div>
            <form method="post" asp-page-handler="Giris" class="stok-movement-form">
                <div class="app-form-grid">
                    <div class="form-field">
                        <label asp-for="Tarih">Tarih</label>
                        <input asp-for="Tarih" type="date" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Miktar">Miktar</label>
                        <input asp-for="Miktar" type="number" min="0.01" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label asp-for="BirimFiyat">Birim Fiyat</label>
                        <input asp-for="BirimFiyat" type="number" min="0" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label asp-for="KdvOrani">KDV Oranı (%)</label>
                        <input asp-for="KdvOrani" type="number" min="0" max="100" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label asp-for="KoliAdedi">Koli Adedi</label>
                        <input asp-for="KoliAdedi" type="number" min="0" step="0.01" />
                    </div>
                    <div class="form-field">
                        <label asp-for="KoliFiyat">Koli Fiyatı</label>
                        <input asp-for="KoliFiyat" type="number" min="0" step="0.01" />
                    </div>
                    <div class="form-field form-field-wide">
                        <label asp-for="Aciklama">Açıklama</label>
                        <input asp-for="Aciklama" />
                    </div>
                </div>
                <div class="form-actions-row">
                    <button type="submit" class="btn btn-primary">Stok Girişi Kaydet</button>
                </div>
            </form>
        </div>

        <div class="app-form-panel">
            <div class="panel-title-row">
                <div><h2>Stok Çıkışı</h2><p>Mevcut stok miktarını aşmadan çıkış kaydedin.</p></div>
            </div>
            <form method="post" asp-page-handler="Cikis" class="stok-movement-form">
                <div class="app-form-grid">
                    <div class="form-field">
                        <label asp-for="Tarih">Tarih</label>
                        <input asp-for="Tarih" type="date" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Miktar">Miktar</label>
                        <input asp-for="Miktar" type="number" min="0.01" step="0.01" />
                    </div>
                    <div class="form-field form-field-wide">
                        <label asp-for="Aciklama">Açıklama</label>
                        <input asp-for="Aciklama" />
                    </div>
                </div>
                <div class="form-actions-row">
                    <button type="submit" class="btn btn-outline-danger">Stok Çıkışı Kaydet</button>
                </div>
            </form>
        </div>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row">
            <div>
                <h2>Stok Hareketleri</h2>
                <p>Son @Model.Hareketler.Count giriş ve çıkış kaydı</p>
            </div>
        </div>
        <div class="table-wrap">
            <table class="modern-table stock-movement-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tür</th>
                        <th>Miktar</th>
                        <th>Birim Fiyat</th>
                        <th>KDV</th>
                        <th>KDV Dahil Toplam</th>
                        <th>Koli</th>
                        <th>Açıklama</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Hareketler.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-row">Henüz stok hareketi yok.</td></tr>
                    }
                    else
                    {
                        @foreach (var hareket in Model.Hareketler)
                        {
                            <tr>
                                <td>@hareket.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="status-pill @(hareket.Tip == StokHareketTipi.Giris ? "status-pill-income" : "status-pill-expense")">
                                        @(hareket.Tip == StokHareketTipi.Giris ? "Giriş" : "Çıkış")
                                    </span>
                                </td>
                                <td><strong>@hareket.Miktar.ToString("N2")</strong></td>
                                <td>@hareket.BirimFiyat.ToString("N2") ₺</td>
                                <td>%@hareket.KdvOrani.ToString("N2")</td>
                                <td class="amount-cell">@hareket.ToplamTutar.ToString("N2") ₺</td>
                                <td>@hareket.KoliAdedi.ToString("N2") / @hareket.KoliFiyat.ToString("N2") ₺</td>
                                <td>@(string.IsNullOrWhiteSpace(hareket.Aciklama) ? "-" : hareket.Aciklama)</td>
                                <td>
                                    <form method="post" asp-page-handler="Sil" class="inline-form"
                                          onsubmit="return confirm('Stok hareketi silinsin mi?');">
                                        <input type="hidden" name="id2" value="@hareket.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
