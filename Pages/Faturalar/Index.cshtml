@page
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.Faturalar.IndexModel
@{
    ViewData["Title"] = "Faturalar";
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Fatura / Tahsilat / Ödeme</span>
            <h1>Faturalar</h1>
            <p>Satış ve alış faturalarını kaydedin; tahsilat ve ödemeleri otomatik kasaya işleyin.</p>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-outline-success"
               asp-page-handler="DisaAktar"
               asp-route-FiltreTarih="@Model.FiltreTarih?.ToString("yyyy-MM-dd")"
               asp-route-FiltreCariId="@Model.FiltreCariId"
               asp-route-FiltreDurum="@Model.FiltreDurum"
               asp-route-FiltreFaturaNo="@Model.FiltreFaturaNo">Excel İndir</a>
            <a class="btn btn-outline-dark" href="/Kasa/Hareketler">Kasa Hareketleri</a>
            <a class="btn btn-outline-dark" href="/CariKartlar">Cari Kartlar</a>
        </div>
    </section>

    @if (TempData["Hata"] != null)
    {
        <div class="app-alert app-alert-danger">@TempData["Hata"]</div>
    }
    @if (TempData["Basari"] != null)
    {
        <div class="app-alert app-alert-success">@TempData["Basari"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="app-alert app-alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="metric-grid">
        <article class="metric-card metric-card-positive"><span>Satış Faturaları</span><strong>@Model.ToplamSatis.ToString("N2")</strong></article>
        <article class="metric-card metric-card-negative"><span>Alış Faturaları</span><strong>@Model.ToplamAlis.ToString("N2")</strong></article>
        <article class="metric-card"><span>Bekleyen Tahsilat</span><strong>@Model.BekleyenTahsilat.ToString("N2")</strong></article>
        <article class="metric-card metric-card-negative"><span>Bekleyen Ödeme</span><strong>@Model.BekleyenOdeme.ToString("N2")</strong></article>
    </section>

    <section class="app-form-panel">
        <div class="panel-title-row">
            <div>
                <h2>Yeni Fatura</h2>
                <p>Aynı faturaya birden fazla ürün veya hizmet kalemi ekleyebilirsiniz.</p>
            </div>
        </div>
        <form method="post" asp-page-handler="Ekle" class="app-form-grid invoice-form-grid">
            <div class="form-field form-field-wide">
                <label asp-for="Yeni.CariKartId">Cari</label>
                <select asp-for="Yeni.CariKartId">
                    <option value="0">Cari seçin</option>
                    @foreach (var cari in Model.Cariler)
                    {
                        <option value="@cari.Id">@cari.Unvan (@(cari.Tip == CariTip.Alici ? "Alıcı" : "Satıcı"))</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Yeni.Tip">Fatura Tipi</label>
                <select asp-for="Yeni.Tip">
                    <option value="@FaturaTipi.Satis">Satış</option>
                    <option value="@FaturaTipi.Alis">Alış</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Yeni.FaturaNo">Fatura No</label>
                <input asp-for="Yeni.FaturaNo" placeholder="Boşsa otomatik: @Model.NumaraAyari.SiradakiOrnek" />
            </div>
            <div class="form-field"><label asp-for="Yeni.Tarih">Tarih</label><input asp-for="Yeni.Tarih" type="date" /></div>
            <div class="form-field"><label asp-for="Yeni.VadeTarihi">Vade</label><input asp-for="Yeni.VadeTarihi" type="date" /></div>

            <div class="invoice-lines-panel">
                <div class="invoice-lines-header">
                    <div><h3>Fatura Kalemleri</h3><p>Her satır ayrı ürün/hizmet olarak hesaplanır.</p></div>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="addInvoiceLine">Kalem Ekle</button>
                </div>
                <div class="table-wrap">
                    <table class="modern-table invoice-lines-table">
                        <thead><tr><th>Kalem Açıklaması</th><th>Miktar</th><th>Birim Fiyat</th><th>KDV %</th><th>İşlem</th></tr></thead>
                        <tbody id="invoiceLinesBody">
                            @for (var i = 0; i < Model.Yeni.Kalemler.Count; i++)
                            {
                                <tr class="invoice-line-row">
                                    <td><input name="Yeni.Kalemler[@i].Aciklama" value="@Model.Yeni.Kalemler[i].Aciklama" placeholder="Ürün/hizmet açıklaması" /></td>
                                    <td><input name="Yeni.Kalemler[@i].Miktar" value="@Model.Yeni.Kalemler[i].Miktar.ToString("0.##")" type="number" step="0.01" min="0" /></td>
                                    <td><input name="Yeni.Kalemler[@i].BirimFiyat" value="@Model.Yeni.Kalemler[i].BirimFiyat.ToString("0.##")" type="number" step="0.01" min="0" /></td>
                                    <td><input name="Yeni.Kalemler[@i].KdvOrani" value="@Model.Yeni.Kalemler[i].KdvOrani.ToString("0.##")" type="number" step="0.01" min="0" /></td>
                                    <td><button type="button" class="btn btn-outline-danger btn-sm remove-invoice-line">Sil</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="form-field form-field-wide"><label asp-for="Yeni.Aciklama">Not</label><input asp-for="Yeni.Aciklama" placeholder="Opsiyonel açıklama" /></div>
            <div class="form-actions-row"><button type="submit" class="btn btn-primary">Fatura Oluştur</button></div>
        </form>
    </section>

    <section class="app-filter-bar">
        <form method="get" class="app-form-grid">
            <div class="form-field">
                <label asp-for="FiltreTarih">Tarih</label>
                <input asp-for="FiltreTarih" type="date" />
            </div>
            <div class="form-field">
                <label asp-for="FiltreCariId">Cari / Müşteri</label>
                <select asp-for="FiltreCariId">
                    <option value="">Tümü</option>
                    @foreach (var cari in Model.Cariler)
                    {
                        <option value="@cari.Id">@cari.Unvan</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="FiltreDurum">Durum</label>
                <select asp-for="FiltreDurum">
                    <option value="">Tümü</option>
                    @foreach (var durum in Enum.GetValues<FaturaDurumu>())
                    {
                        <option value="@durum">@durum.Metin()</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label asp-for="FiltreFaturaNo">Fatura No</label>
                <input asp-for="FiltreFaturaNo" placeholder="Fatura numarası" />
            </div>
            <div class="form-actions-row">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a class="btn btn-outline-dark" href="/Faturalar">Temizle</a>
            </div>
        </form>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row"><div><h2>Fatura Listesi</h2><p>@Model.Faturalar.Count kayıt</p></div></div>
        <div class="table-wrap">
            <table class="modern-table invoice-table">
                <thead><tr><th>Tarih</th><th>No</th><th>Tip</th><th>Cari</th><th>Kalem</th><th>Toplam</th><th>Ödenen</th><th>Kalan</th><th>Durum</th><th>Tahsilat / Ödeme</th><th>İşlem</th></tr></thead>
                <tbody>
                    @if (Model.Faturalar.Count == 0)
                    {
                        <tr><td colspan="11" class="empty-row">Henüz fatura yok.</td></tr>
                    }
                    else
                    {
                        @foreach (var fatura in Model.Faturalar)
                        {
                            var satisMi = fatura.Tip == FaturaTipi.Satis;
                            var tamamlandiMi = fatura.Durum is FaturaDurumu.Odendi or FaturaDurumu.Iptal;
                            var durumClass = fatura.Durum == FaturaDurumu.Odendi
                                ? "status-pill-income"
                                : fatura.Durum == FaturaDurumu.Iptal
                                    ? "status-pill-expense"
                                    : "";
                            <tr class="invoice-row">
                                <td>@fatura.Tarih.ToString("dd.MM.yyyy")</td>
                                <td><strong>@fatura.FaturaNo</strong></td>
                                <td><span class="status-pill @(satisMi ? "status-pill-income" : "status-pill-expense")">@(satisMi ? "Satış" : "Alış")</span></td>
                                <td>@(fatura.CariKart?.Unvan ?? "-")</td>
                                <td>@fatura.Kalemler.Count</td>
                                <td class="amount-cell">@fatura.GenelToplam.ToString("N2")</td>
                                <td>@fatura.OdenenToplam.ToString("N2")</td>
                                <td class="amount-cell @(fatura.Durum == FaturaDurumu.Odendi ? "amount-income" : "amount-expense")">@Math.Max(0, fatura.KalanTutar).ToString("N2")</td>
                                <td><span class="status-pill @durumClass">@fatura.Durum.Metin()</span></td>
                                <td>
                                    @if (tamamlandiMi)
                                    {
                                        <span class="text-muted">@(fatura.Durum == FaturaDurumu.Iptal ? "İptal edildi" : "Tamamlandı")</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Odeme" class="invoice-payment-form">
                                            <input type="hidden" asp-for="Odeme.FaturaId" value="@fatura.Id" />
                                            <input asp-for="Odeme.Tutar" type="number" step="0.01" min="0" max="@fatura.KalanTutar" placeholder="Tutar" />
                                            <input asp-for="Odeme.Tarih" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm">@(satisMi ? "Tahsil Et" : "Öde")</button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    <div class="invoice-action-stack">
                                        <a class="btn btn-outline-primary btn-sm" asp-page="/Faturalar/Detay" asp-route-id="@fatura.Id">Detay</a>
                                        <a class="btn btn-outline-dark btn-sm" asp-page="/Faturalar/Duzenle" asp-route-id="@fatura.Id">Düzenle</a>
                                        <form method="post" asp-page-handler="Sil" class="inline-form" onsubmit="return confirm('Bu fatura silinecek. Daha önce kasaya işlenen tahsilat/ödeme hareketleri silinmez. Devam edilsin mi?');">
                                            <input type="hidden" name="id" value="@fatura.Id" />
                                            <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function reindexInvoiceLines() {
            document.querySelectorAll('#invoiceLinesBody .invoice-line-row').forEach(function (row, index) {
                row.querySelectorAll('input').forEach(function (input) {
                    input.name = input.name.replace(/Yeni\.Kalemler\[\d+\]/, 'Yeni.Kalemler[' + index + ']');
                });
            });
        }

        document.getElementById('addInvoiceLine')?.addEventListener('click', function () {
            const body = document.getElementById('invoiceLinesBody');
            const index = body.querySelectorAll('.invoice-line-row').length;
            const row = document.createElement('tr');
            row.className = 'invoice-line-row';
            row.innerHTML = `
                <td><input name="Yeni.Kalemler[${index}].Aciklama" placeholder="Ürün/hizmet açıklaması" /></td>
                <td><input name="Yeni.Kalemler[${index}].Miktar" type="number" step="0.01" min="0" value="1" /></td>
                <td><input name="Yeni.Kalemler[${index}].BirimFiyat" type="number" step="0.01" min="0" /></td>
                <td><input name="Yeni.Kalemler[${index}].KdvOrani" type="number" step="0.01" min="0" value="20" /></td>
                <td><button type="button" class="btn btn-outline-danger btn-sm remove-invoice-line">Sil</button></td>`;
            body.appendChild(row);
        });

        document.getElementById('invoiceLinesBody')?.addEventListener('click', function (event) {
            const button = event.target.closest('.remove-invoice-line');
            if (!button) return;
            const rows = document.querySelectorAll('#invoiceLinesBody .invoice-line-row');
            if (rows.length <= 1) return;
            button.closest('tr').remove();
            reindexInvoiceLines();
        });
    </script>
}
