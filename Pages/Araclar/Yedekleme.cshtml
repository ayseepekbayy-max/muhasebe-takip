@page
@model MuhasebeTakip2.App.Pages.Araclar.YedeklemeModel
@{
    ViewData["Title"] = "Yedekleme";
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Araçlar</span>
            <h1>Yedekleme / Geri Yükleme</h1>
            <p>Muhasebe kayıtlarını, arşivleri ve bağlı belgeleri tek ZIP dosyasında saklayın.</p>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-primary" href="/Araclar/Yedekleme?handler=Indir">Yedek İndir</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }
    @if (Model.BaglantiHatalari.Count > 0)
    {
        <section class="app-form-panel">
            <h2>Kontrol edilmesi gereken bağlantılar</h2>
            <p>Bu liste sorunlu bağlantıları gösterir; otomatik düzeltme veya silme yapılmaz.</p>
            <div style="overflow-x:auto">
                <table class="table">
                    <thead><tr><th>Kayıt türü</th><th>Kayıt no</th><th>Bağlantı alanı</th><th>Bulunamayan bağlı kayıt türü</th><th>Bağlı kayıt no</th></tr></thead>
                    <tbody>
                    @foreach (var sorun in Model.BaglantiHatalari)
                    {
                        <tr><td>@sorun.RecordType</td><td>@sorun.RecordId</td><td>@sorun.Field</td><td>@sorun.RelatedType</td><td>@sorun.RelatedId</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Mesaj))
    {
        <div class="app-alert app-alert-success">@Model.Mesaj</div>
    }

    <section class="app-form-panel">
        <div class="panel-title-row"><div><h2>Güvenli Geri Yükleme</h2><p>Mevcut kayıtlar silinmez. Tam ZIP yedeği yalnızca boş muhasebe alanına yüklenir; mevcut kayıt varsa işlem durur. Eski JSON dosyaları eksik kapsam uyarısıyla desteklenir.</p></div></div>
        <p>Tam yedek: cari, fatura ve kalemleri, kasa, çek görselleri, stok hareketleri, personel ve maaş/avans/puantaj, müşteri işleri/masrafları, maliyetler, ödeme planları ve hareketleri, işlem geçmişi ve ek belgeler. Arşivlenmiş kayıtlar dahildir.</p>
        <p>Giriş hesapları, şifreler, firma ayarları ve sohbet dahil değildir. Kullanıcıya bağlı geçmiş için hedef firmada aynı kullanıcı adı ve e-posta ile hesap bulunmalıdır. Yedek en fazla 100 MB, tek belge en fazla 25 MB olabilir.</p>
        <form method="post" asp-page-handler="GeriYukle" enctype="multipart/form-data" class="app-form-grid">
            <div class="form-field form-field-wide">
                <label asp-for="YedekDosyasi">Yedek Dosyası</label>
                <input asp-for="YedekDosyasi" type="file" accept=".zip,.json" />
            </div>
            <div class="form-actions-row">
                <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Seçilen yedek geri yüklenecek. Mevcut kayıtlar silinmez. Devam edilsin mi?');">Geri Yükle</button>
            </div>
        </form>
    </section>
</div>