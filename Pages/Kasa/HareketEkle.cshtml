@page "/Kasa/HareketEkle"
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.Kasa.HareketEkleModel

<div class="app-page">
<section class="app-page-header">
  <div>
    <span class="app-page-eyebrow">Cari / Kasa</span>
    <h1>Tahsilat veya Ödeme Ekle</h1>
    <p>Hareketi isterseniz açık bir faturaya bağlayın; fatura bakiyesi ve kasa birlikte güncellensin.</p>
  </div>
</section>

@if (!ViewData.ModelState.IsValid)
{
  <div style="color:red; margin-bottom:10px;">
    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
      <div>@err.ErrorMessage</div>
    }
  </div>
}

<form method="post" class="app-form-panel" style="max-width:720px;">
  <div style="margin-bottom:10px;">
    <label><b>Tarih</b></label><br />
    <input asp-for="Hareket.Tarih" type="date" style="width:100%; padding:8px;" />
  </div>

  <div style="margin-bottom:10px;">
    <label><b>Tip</b></label><br />
    <select asp-for="Hareket.Tip" style="width:100%; padding:8px;">
      <option value="@((int)HareketTipi.Giris)">Tahsilat (Kasa Girişi)</option>
      <option value="@((int)HareketTipi.Cikis)">Ödeme (Kasa Çıkışı)</option>
    </select>
  </div>

  <div style="margin-bottom:10px;">
    <label><b>Cari</b></label><br />
    <select asp-for="Hareket.CariKartId"
            asp-items="Model.CariSecenekleri"
            style="width:100%; padding:8px;">
    </select>
  </div>

  <div style="margin-bottom:10px;">
    <label><b>Bağlı Fatura</b></label><br />
    <select asp-for="Hareket.FaturaId"
            asp-items="Model.FaturaSecenekleri"
            style="width:100%; padding:8px;">
    </select>
    <small>Fatura seçmezseniz hareket yalnızca genel cari hesabına ve kasaya işlenir.</small>
  </div>

  <div style="margin-bottom:10px;">
    <label><b>Tutar</b></label><br />
    <input asp-for="TutarText" type="text" style="width:100%; padding:8px;" />
  </div>

  <div style="margin-bottom:10px;">
    <label><b>Açıklama</b></label><br />
    <input asp-for="Hareket.Aciklama" style="width:100%; padding:8px;" />
  </div>

  <button type="submit" style="padding:10px 14px;">Kaydet</button>
  @if (Model.Hareket.CariKartId.HasValue)
  {
    <a asp-page="/CariKartlar/Detay/Index" asp-route-id="@Model.Hareket.CariKartId.Value" style="margin-left:10px;">İptal</a>
  }
  else
  {
    <a asp-page="/Kasa/Hareketler" style="margin-left:10px;">İptal</a>
  }
</form>
</div>
