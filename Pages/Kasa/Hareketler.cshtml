@page
@using MuhasebeTakip2.App.Models
@model MuhasebeTakip2.App.Pages.Kasa.HareketlerModel
@{
    ViewData["Title"] = "Kasa Hareketleri";
    var toplamGiris = Model.Hareketler.Where(x => x.Tip == HareketTipi.Giris).Sum(x => x.Tutar);
    var toplamCikis = Model.Hareketler.Where(x => x.Tip == HareketTipi.Cikis).Sum(x => x.Tutar);
}

<div class="app-page">
    <section class="app-page-header">
        <div>
            <span class="app-page-eyebrow">Kasa</span>
            <h1>Kasa Hareketleri</h1>
            <p>Tüm giriş ve çıkış hareketlerini tarih, tip, cari ve açıklamaya göre tarayın.</p>
        </div>

        <div class="app-page-actions">
            <a class="btn btn-primary" href="/Kasa/HareketEkle">Hareket Ekle</a>
            <form method="post" asp-page-handler="DisaAktar">
                <button type="submit" class="btn btn-outline-success">Excel İndir</button>
            </form>
            <a class="btn btn-outline-dark" href="/">Kasa Özeti</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Hata))
    {
        <div class="app-alert app-alert-danger">@Model.Hata</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Mesaj))
    {
        <div class="app-alert app-alert-success">@Model.Mesaj</div>
    }

    <section class="metric-grid metric-grid-three">
        <article class="metric-card metric-card-positive">
            <span>Toplam Giriş</span>
            <strong>@toplamGiris.ToString("N2")</strong>
        </article>
        <article class="metric-card metric-card-negative">
            <span>Toplam Çıkış</span>
            <strong>@toplamCikis.ToString("N2")</strong>
        </article>
        <article class="metric-card">
            <span>Net Hareket</span>
            <strong>@(toplamGiris - toplamCikis).ToString("N2")</strong>
        </article>
    </section>

    <section class="app-filter-bar">
        <div class="form-field">
            <label for="kasaSearch">Hareket ara</label>
            <input id="kasaSearch" type="search" placeholder="Cari, açıklama veya tutar" />
        </div>
        <div class="form-field filter-small">
            <label for="tipFilter">Tip</label>
            <select id="tipFilter">
                <option value="">Tümü</option>
                <option value="giris">Giriş</option>
                <option value="cikis">Çıkış</option>
            </select>
        </div>
    </section>

    <section class="dashboard-panel">
        <div class="panel-title-row">
            <div>
                <h2>Hareket Listesi</h2>
                <p>@Model.Hareketler.Count kayıt</p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tip</th>
                        <th>Tutar</th>
                        <th>Cari</th>
                        <th>Açıklama</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Hareketler.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-row">Henüz hareket yok.</td></tr>
                    }
                    else
                    {
                        @foreach (var h in Model.Hareketler)
                        {
                            var girisMi = h.Tip == HareketTipi.Giris;
                            <tr class="kasa-row" data-type="@(girisMi ? "giris" : "cikis")" data-search="@($"{h.Tarih:dd.MM.yyyy} {h.Tip} {h.Tutar} {h.CariKart?.Unvan} {h.Aciklama}")">
                                <td>@h.Tarih.ToString("dd.MM.yyyy")</td>
                                <td><span class="status-pill @(girisMi ? "status-pill-income" : "status-pill-expense")">@(girisMi ? "Giriş" : "Çıkış")</span></td>
                                <td class="amount-cell @(girisMi ? "amount-income" : "amount-expense")">@h.Tutar.ToString("N2")</td>
                                <td>@(h.CariKart?.Unvan ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(h.Aciklama) ? "-" : h.Aciklama)</td>
                                <td class="table-actions-cell">
                                    <a class="btn btn-outline-primary btn-sm" href="/Kasa/HareketDuzenle/@h.Id">Düzenle</a>
                                    <form method="post" asp-page-handler="Sil" class="inline-form" onsubmit="return confirm('Silinsin mi?');">
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <button type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const kasaSearch = document.getElementById('kasaSearch');
        const tipFilter = document.getElementById('tipFilter');

        function filterKasaRows() {
            const query = (kasaSearch?.value || '').toLocaleLowerCase('tr-TR').trim();
            const type = tipFilter?.value || '';

            document.querySelectorAll('.kasa-row').forEach(function (row) {
                const text = (row.dataset.search || row.innerText).toLocaleLowerCase('tr-TR');
                const typeOk = !type || row.dataset.type === type;
                const textOk = !query || text.includes(query);
                row.hidden = !(typeOk && textOk);
            });
        }

        kasaSearch?.addEventListener('input', filterKasaRows);
        tipFilter?.addEventListener('change', filterKasaRows);
    </script>
}