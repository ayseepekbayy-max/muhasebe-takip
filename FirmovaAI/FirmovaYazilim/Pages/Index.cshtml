@page
@model IndexModel
@{
    ViewData["Title"] = "Firmova Yazılım";
}

<section class="hero">
    <div class="hero-content">
        <span class="badge">Bağımsız Yazılım Girişimi</span>

        <h1>Firmova Yazılım</h1>

        <p>
            Web tabanlı yazılım çözümleri, yapay zekâ destekli sistemler
            ve işletmelere özel dijital projeler geliştiriyoruz.
        </p>

        <div class="hero-buttons">
            <a href="/Projeler" class="btn-primary">Projeleri İncele</a>
            <a href="/Iletisim" class="btn-secondary">İletişime Geç</a>
        </div>
    </div>
</section>

<section class="section">
    <h2>Neler Yapıyoruz?</h2>

    <div class="cards">
        <div class="card">
            <h3>Web Yazılım</h3>
            <p>İşletmelere özel web tabanlı paneller, takip sistemleri ve kurumsal çözümler geliştiriyoruz.</p>
        </div>

        <div class="card">
            <h3>Yapay Zekâ</h3>
            <p>Akıllı asistanlar, soru-cevap sistemleri ve iş süreçlerini kolaylaştıran yapay zekâ çözümleri hazırlıyoruz.</p>
        </div>

        <div class="card">
            <h3>İşletme Sistemleri</h3>
            <p>Muhasebe, stok, müşteri, çalışan ve maliyet takibi gibi özel işletme sistemleri oluşturuyoruz.</p>
        </div>
    </div>
</section>

<section class="section dark">
    <h2>Öne Çıkan Projeler</h2>

    <div class="project-list">
        <div class="project">
            <h3>MuhasebeTakip</h3>
            <p>Kasa, cari, stok, çalışan, müşteri ve maliyet takibi için geliştirilen web tabanlı sistem.</p>
        </div>

        <div class="project">
            <h3>Firmova AI</h3>
            <p>İşletme verilerini yorumlayan ve doğal dil ile cevap verebilen yapay zekâ destekli asistan.</p>
        </div>

        <div class="project">
            <h3>ANKARTE</h3>
            <p>Mobilya ve tasarım alanında ürün tanıtımı ve yönetim süreçleri için hazırlanan web projesi.</p>
        </div>
    </div>
</section>